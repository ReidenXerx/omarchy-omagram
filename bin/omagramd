LOTTIE = pathlib.Path(safe.home_dir()) / ".cache/omagram/lottie"
# Telegram caps animated stickers at 64 KB compressed; a megabyte is far past any real one.
TGS_MAX = 1024 * 1024
LOTTIE_MAX = 16 * 1024 * 1024
LOTTIE_LIMITS = {"max_depth": 64, "max_items": 2_000_000, "max_string": 1024 * 1024}
LOTTIE_CACHE_MAX = 256 * 1024 * 1024    # unpacked stickers kept on disk; the oldest go first
LOTTIE_CACHE_FILES = 4096
LOTTIE_FAILED_MAX = 512
_lottie_failed = {}                     # stickers that are not sane TGS, by hash: never inflated twice
_lottie_writes = 0
EVENTS_MAX = 50000                      # TDLib updates waiting for the loop
FILE_ID_MAX = 2 ** 31 - 1
DOCUMENT_MAX = 2 * 1024 ** 3                        # Telegram's file limit without Premium
PHOTO_MAX = 10 * 1024 ** 2                          # larger images go as documents
PHOTO_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp")
VIDEO_EXTENSIONS = (".mp4", ".mov", ".m4v")         # playable videos; other video files go as files
AUDIO_EXTENSIONS = (".mp3", ".m4a", ".flac", ".ogg", ".opus")
FILES_MAX = 10                                       # files sent at once: an album's most
CAPTION_MAX = 1024
MARKDOWN_CAPTION_MAX = 2 * CAPTION_MAX
STICKERS_MAX = 300
SET_ID = re.compile(r"-?[0-9]{1,20}")

PHONE = re.compile(r"\+?[0-9][0-9 ()-]{4,30}")
CODE = re.compile(r"[0-9]{3,10}")

LOG = print


class BadRequest(Exception):
    pass


def lottie_json(path):
    """The Lottie animation inside a TGS sticker (gzip-compressed JSON), written once to a
    private cache named by the sticker's hash. Returns that path, or "" for anything that is
    not a sane TGS. Inflation stops at LOTTIE_MAX, so a compression bomb costs nothing, and
    the JSON's shape is bounded before the UI's Lottie parser ever sees it. A sticker that
    failed is remembered and not inflated again, and the cache is kept under a ceiling."""
    global _lottie_writes
    try:
        blob = safe.read_file(path, TGS_MAX)
    except (safe.UnsafeError, OSError):
        return ""
    if not blob or blob[:2] != b"\x1f\x8b":
        return ""
    digest = hashlib.sha256(blob).hexdigest()
    target = LOTTIE / (digest + ".json")
    if cached_lottie(target):
        return str(target)
    if digest in _lottie_failed:
        return ""
    inflater = zlib.decompressobj(16 + zlib.MAX_WBITS)
    doc = None
    try:
        data = inflater.decompress(blob, LOTTIE_MAX + 1)
        if len(data) <= LOTTIE_MAX and not inflater.unconsumed_tail:
            doc = safe.loads(data, **LOTTIE_LIMITS)
    except (zlib.error, ValueError, UnicodeDecodeError, safe.UnsafeError):
        doc = None
    if not isinstance(doc, dict):
        _lottie_failed[digest] = True
        if len(_lottie_failed) > LOTTIE_FAILED_MAX:
            del _lottie_failed[next(iter(_lottie_failed))]
        return ""
    try:
        safe.write_file(target, data, mode=0o600)
    except (safe.UnsafeError, OSError):
        return ""
    _lottie_writes += 1
    if _lottie_writes % 32 == 0:
        trim_lottie_cache()
    return str(target)


def cached_lottie(target):
    """An already unpacked sticker: a regular file of ours, within the size limit."""
    try:
        st = os.lstat(target)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and 0 < st.st_size <= LOTTIE_MAX


def trim_lottie_cache():
    """Keeps the unpacked stickers under their size and count ceilings, the oldest out first."""
    entries = lottie_cache_entries()
    total = sum(st.st_size for _, st in entries)
    if total <= LOTTIE_CACHE_MAX and len(entries) <= LOTTIE_CACHE_FILES:
        return
    entries.sort(key=lambda entry: entry[1].st_mtime)
    while entries and (total > LOTTIE_CACHE_MAX * 4 // 5 or len(entries) > LOTTIE_CACHE_FILES * 4 // 5):
        name, st = entries.pop(0)
        try:
            safe.remove_file(LOTTIE / name)
        except (safe.UnsafeError, OSError):
            pass
        total -= st.st_size


def lottie_cache_entries():
    try:
        return [(name, st) for name, st in safe.list_dir(LOTTIE, max_entries=LOTTIE_CACHE_FILES * 2)
                if name.endswith(".json") and stat.S_ISREG(st.st_mode)]
    except (safe.UnsafeError, OSError):
        return []


def clear_lottie_cache():
    for name, _ in lottie_cache_entries():
        try:
            safe.remove_file(LOTTIE / name)
        except (safe.UnsafeError, OSError):
            pass


def local_upload(path):
    """A file you chose to send: an absolute path to a non-empty regular file you can read,
    within Telegram's size limit. Omagram's own database directory is never sent.
    Returns (real path, size)."""
    if not isinstance(path, str) or not path.startswith("/") or len(path) > 4096 or any(ord(c) < 32 for c in path):
        raise BadRequest("the file must be given as an absolute path")
    try:
        real = os.path.realpath(path)
        st = os.stat(real)
    except OSError:
        raise BadRequest("that file does not exist") from None
    if not stat.S_ISREG(st.st_mode):
        raise BadRequest("only regular files can be sent")
    database = str(td.DATABASE) + "/"
    if real == str(td.DATABASE) or real.startswith(database):
        raise BadRequest("Omagram's own database is not sent")
    if not os.access(real, os.R_OK):
        raise BadRequest("that file is not readable")
    if st.st_size == 0:
        raise BadRequest("that file is empty")
    if st.st_size > DOCUMENT_MAX:
        raise BadRequest("Telegram accepts files up to 2 GB")
    return real, st.st_size


