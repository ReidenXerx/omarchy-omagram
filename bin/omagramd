        for raw in model._list(event.get("user_ids"), CONTACTS_MAX):
            user = self.state.users.get(model._int(raw))
            if user:
                views.append({"userId": user["id"], "name": user["name"], "username": user["username"],
                              "bot": user["bot"], "status": user["status"]})
        return views

