def file_kind(path, size, as_media):
    """How a file goes out: as a photo, a playable video or music when sent as media and Telegram can
    take it so, otherwise as a file."""
    lower = path.lower()
    if as_media and lower.endswith(PHOTO_EXTENSIONS) and size <= PHOTO_MAX:
        return "photo"
    if as_media and lower.endswith(VIDEO_EXTENSIONS):
        return "video"
    if as_media and lower.endswith(AUDIO_EXTENSIONS):
        return "audio"
    return "document"


def file_content(path, kind, caption, probed):
    """The message content for a file; `probed` is (duration, width, height) for videos and music."""
    upload = {"@type": "inputFileLocal", "path": path}
    duration, width, height = probed
    if kind == "photo":
        return {"@type": "inputMessagePhoto", "caption": caption, "show_caption_above_media": False,
                "self_destruct_type": None, "has_spoiler": False,
                "photo": {"@type": "inputPhoto", "photo": upload, "thumbnail": None, "video": None,
                          "added_sticker_file_ids": [], "width": 0, "height": 0}}
    if kind == "video":
        return {"@type": "inputMessageVideo", "caption": caption, "show_caption_above_media": False,
                "self_destruct_type": None, "has_spoiler": False,
                "video": {"@type": "inputVideo", "video": upload, "thumbnail": None, "cover": None, "start_timestamp": 0,
                          "added_sticker_file_ids": [], "duration": duration, "width": width, "height": height,
                          "supports_streaming": True}}
    if kind == "audio":
        return {"@type": "inputMessageAudio", "caption": caption,
                "audio": {"@type": "inputAudio", "audio": upload, "album_cover_thumbnail": None, "duration": duration,
                          "title": "", "performer": ""}}
    return {"@type": "inputMessageDocument", "caption": caption,
            "document": {"@type": "inputDocument", "document": upload, "thumbnail": None,
                         "disable_content_type_detection": False}}


def album_groups(kinds):
    """Which files go out together, by index: photos and videos share albums, files and music have
    albums of their own, each at most ten, in the order the files were given."""
    buckets = {}
    for i, kind in enumerate(kinds):
        buckets.setdefault("media" if kind in ("photo", "video") else kind, []).append(i)
    return [items[n:n + FILES_MAX] for items in buckets.values() for n in range(0, len(items), FILES_MAX)]


JOIN_RESULTS = {"chatJoinResultSuccess": "joined", "chatJoinResultRequestSent": "requested",
                "chatJoinResultGuardBotApprovalRequired": "guardBot", "chatJoinResultDeclined": "declined"}


def join_result(event, chat_id=0):
    """What joining came to: joined, a request for the admins to approve, a guard bot to satisfy
    first (its page opens only in another Telegram app), or declined by that bot."""
    return {"chatId": model._int(event.get("chat_id")) or chat_id, "state": JOIN_RESULTS.get(event.get("@type"), "")}


def folder_object(args):
    """A chatFolder for TDLib from what the window sends, checked: a name of 1-12 characters on one line,
    the kinds of chats it takes and leaves out, and the chats pinned in it, always in it and never in it."""
    name = arg_str(args, "name", 64).strip()
    if not 1 <= len(name) <= FOLDER_NAME_MAX or any(ord(c) < 32 for c in name):
        raise BadRequest(f"a folder's name is 1-{FOLDER_NAME_MAX} characters on one line")
    icon, color = args.get("icon"), args.get("colorId", -1)
    folder = {"@type": "chatFolder",
              "name": {"@type": "chatFolderName", "animate_custom_emoji": False,
                       "text": {"@type": "formattedText", "text": name, "entities": []}},
              "icon": {"@type": "chatFolderIcon", "name": icon} if isinstance(icon, str) and icon in FOLDER_ICONS else None,
              "color_id": color if isinstance(color, int) and not isinstance(color, bool) and -1 <= color <= 6 else -1,
              "is_shareable": args.get("shareable") is True}
    for key, field in model.FOLDER_FLAGS.items():
        value = args.get(key, False)
        if not isinstance(value, bool):
            raise BadRequest(f"{key} is true or false")
        folder[field] = value
    for key, field in (("pinned", "pinned_chat_ids"), ("included", "included_chat_ids"), ("excluded", "excluded_chat_ids")):
        ids = args.get(key, [])
        if (not isinstance(ids, list) or len(ids) > FOLDER_CHATS_MAX
                or any(isinstance(i, bool) or not isinstance(i, int) or i == 0 or abs(i) > INT64_MAX for i in ids)):
            raise BadRequest(f"{key} is a list of at most {FOLDER_CHATS_MAX} chat ids")
        folder[field] = list(dict.fromkeys(ids))
    takes = [field for key, field in model.FOLDER_FLAGS.items() if key.startswith("include")]
    if not (folder["pinned_chat_ids"] or folder["included_chat_ids"] or any(folder[field] for field in takes)):
        raise BadRequest("a folder needs chats: a kind of chat it takes, or a chat always in it")
    return folder


def mention_links(entities):
    """A Markdown link to tg://user?id=N, as suggestions put in for someone with no username, is a
    mention of that person by name."""
    out = []
    for e in entities:
        kind = e.get("type") if isinstance(e, dict) else None
        url = kind.get("url") if isinstance(kind, dict) and kind.get("@type") == "textEntityTypeTextUrl" else None
        found = MENTION_LINK.fullmatch(url) if isinstance(url, str) else None
        out.append(dict(e, type={"@type": "textEntityTypeMentionName", "user_id": int(found.group(1))}) if found else e)
    return out


def arg_int(args, name, low=None, high=None, default=None):
    value = args.get(name, default)
    if isinstance(value, bool) or not isinstance(value, int):
        raise BadRequest(f"{name} must be an integer")
    if not -INT64_MAX <= value <= INT64_MAX:   # JSON integers are unbounded; TDLib's are not
        raise BadRequest(f"{name} is out of range")
    if (low is not None and value < low) or (high is not None and value > high):
        raise BadRequest(f"{name} is out of range")
    return value


def download_name(value):
    """A file name to save under: its last path part, printable, not hidden, never empty."""
    name = os.path.basename(value.replace("\\", "/")) if isinstance(value, str) else ""
    name = "".join(ch for ch in name if ch.isprintable() and ch not in "/\x00")[:200].strip().lstrip(".")
    return name or "file"


def copy_out(source, directory, name):
    """Copy a downloaded file into `directory` under a name no file there has yet (never
    overwriting, never through a symbolic link); returns the new path."""
    safe.ensure_dir(directory, 0o755)
    stem, suffix = os.path.splitext(name)
    src = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        if not stat.S_ISREG(os.fstat(src).st_mode):
            raise safe.UnsafeError("not a regular file")
        for n in range(1, 1000):
            candidate = pathlib.Path(directory) / (name if n == 1 else f"{stem} ({n}){suffix}")
            try:
                dst = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
            except FileExistsError:
                continue
            try:
                with os.fdopen(dst, "wb") as out:
                    while True:
                        chunk = os.read(src, 1 << 20)
                        if not chunk:
                            break
                        out.write(chunk)
            except BaseException:
                os.unlink(candidate)
                raise
            return candidate
        raise safe.UnsafeError("no free file name")
    finally:
        os.close(src)


def clipboard_types():
    r = safe.run([str(safe.tool("wl-paste")), "--list-types"], timeout=3, max_output=16 * 1024)
    return r.text().split() if r.ok else []


def clipboard_data(mime):
    r = safe.run([str(safe.tool("wl-paste")), "--no-newline", "--type", mime], timeout=5, max_output=CLIPBOARD_MAX + 1)
    data = r.stdout if isinstance(r.stdout, bytes) else bytes(r.stdout or b"")
    return data if r.ok and 0 < len(data) <= CLIPBOARD_MAX else None


def arg_list(args, name="list"):
    """A chat list by its UI key -- main, archive or folder:<id> -- and as TDLib's ChatList."""
    key = args.get(name, "main")
    if not isinstance(key, str) or not re.fullmatch(r"main|archive|folder:[1-9][0-9]{0,9}", key):
        raise BadRequest(f"{name} is main, archive or folder:<id>")
    if key == "main":
        return key, {"@type": "chatListMain"}
    if key == "archive":
        return key, {"@type": "chatListArchive"}
    folder = int(key.split(":")[1])
    if folder > INT32_MAX:
        raise BadRequest(f"{name} is main, archive or folder:<id>")
    return key, {"@type": "chatListFolder", "chat_folder_id": folder}


def arg_str(args, name, max_len, min_len=1):
    value = args.get(name)
    if not isinstance(value, str) or not min_len <= len(value) <= max_len:
        raise BadRequest(f"{name} must be text of {min_len}-{max_len} characters")
    return value


def arg_ids(args, name):
    value = args.get(name)
    if not isinstance(value, list) or not 1 <= len(value) <= IDS_MAX:
        raise BadRequest(f"{name} must be a list of 1-{IDS_MAX} message ids")
    for item in value:
        if isinstance(item, bool) or not isinstance(item, int) or item <= 0:
            raise BadRequest(f"{name} must contain message ids")
    return value


class Client:
    __slots__ = ("sock", "inbox", "outbox", "window")

    def __init__(self, sock):
        self.sock = sock
        self.inbox = bytearray()
        self.outbox = bytearray()
        self.window = False   # Omagram's window (said so in hello), not the bar or a tool


class Daemon:
    def __init__(self, open_client=None, keyring=None, notifier_factory=None):
        self.open_client = open_client or td.open_client
        self.keyring = keyring or td
        self.notifier_factory = notifier_factory or (lambda on_action: notify.Notifier(notify.GioTransport, on_action))
        self.notifier = notify.Notifier(None, None)
        self.pending_open = None   # (monotonic time, {"chatId", "reply"}) for the next window
        self.focus_client = None   # the client whose focused chat keeps notifications quiet
        self.recording = None      # the voice message being recorded: proc, path, chatId, started
        self.tasks = queue.Queue() # finished background work, run on the loop: (done, result, error)
        self.jobs = 0
        self.prefs = prefs.load()   # your shortcuts, as stored in ~/.config/omagram/settings.json
        self.global_status = {action: "off" for action in prefs.GLOBALS}
        self.children = {}   # detached helpers still running: pid -> what to do if they fail
        self.gif_bot_id = 0  # the @gif inline bot, once looked up
        self.state = model.State(td.MEDIA_ROOTS)
        self.td = None
        self.auth = {"state": "starting"}
        self.clients = {}
        self.pending = {}
        self.next_extra = 1
        self.events = queue.Queue(maxsize=EVENTS_MAX)
        self.stopping = False
        self.closed = threading.Event()
        self.sel = selectors.DefaultSelector()
        self.wake_r, self.wake_w = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        self.sel.register(self.wake_r, selectors.EVENT_READ, "wake")
        self.listener = None
        self.lock_fd = None

    # ---------------------------------------------------------------- lifecycle

    def acquire(self):
        """True if this is the only instance for this login."""
        safe.ensure_dir(RUN, 0o700)
        fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(fd)
            return False
        self.lock_fd = fd
        return True

    def listen(self):
        try:
            st = os.stat(SOCKET, follow_symlinks=False)
            if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid():
                os.unlink(SOCKET)   # left by an instance that is gone: we hold the lock
            else:
                raise safe.UnsafeError(f"{SOCKET} exists and is not our socket")
        except FileNotFoundError:
            pass
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
        old = os.umask(0o177)
        try:
            sock.bind(str(SOCKET))
        finally:
            os.umask(old)
        os.chmod(SOCKET, 0o600)
        sock.listen(8)
        sock.setblocking(False)
        self.listener = sock
        self.sel.register(sock, selectors.EVENT_READ, "listen")

    def wake(self):
        try:
            os.write(self.wake_w, b"!")
        except (BlockingIOError, OSError):
            pass

    def stop(self, *_):
        self.stopping = True
        self.wake()

    def start_td(self):
        try:
            self.td = self.open_client()
        except td.TdUnavailable as e:
            self.set_auth({"state": "noLibrary", "reason": str(e)})
            return
        threading.Thread(target=self.receive_loop, daemon=True).start()
        # Any request activates a new client; its answer is not needed.
        self.td_send({"@type": "getOption", "name": "version"})

    def receive_loop(self):
        while not self.stopping or not self.closed.is_set():
            event = self.td.receive(1.0)
            if event is not None:
                self.enqueue(event)
            elif self.stopping and self.closed.is_set():
                return

    def enqueue(self, event):
        """Hands an update to the loop. When the loop falls behind this waits, and TDLib keeps
        the rest, rather than the queue growing without end."""
        while True:
            try:
                self.events.put(event, timeout=1.0)
                break
            except queue.Full:
                if self.closed.is_set():
                    return
        self.wake()

    def run(self):
        # Created on the thread that pumps it: Gio delivers bus signals to this context.
        self.notifier = self.notifier_factory(self.on_notification_action)
        try:
            media.rec_dir()
            media.sent_dir()
            media.clean_stale()
        except (safe.UnsafeError, OSError):
            pass
        trim_lottie_cache()
        if self.prefs["globalShortcuts"]:
            self.apply_globals()
        self.listen()
        self.start_td()
        while not self.stopping:
            for key, mask in self.sel.select(timeout=0.25 if self.notifier.available else 1.0):
                if key.data == "wake":
                    self.drain_wake()
                elif key.data == "listen":
                    self.accept()
                else:
                    self.on_socket(key.data, mask)
            self.process_events()
            self.run_tasks()
            self.notifier.pump()
            self.reap_children()
        self.shutdown()

    def shutdown(self):
        if self.recording is not None:   # a half-recorded voice message is not kept
            self.recording["proc"].kill()
            media.remove(self.recording["path"])
            self.recording = None
        if self.td is not None and not self.closed.is_set():
            # A clean close lets TDLib flush its database; waiting is bounded.
            self.td.send({"@type": "close"})
            deadline = time.monotonic() + CLOSE_TIMEOUT
            while not self.closed.is_set() and time.monotonic() < deadline:
                try:
                    event = self.events.get(timeout=0.2)
                except queue.Empty:
                    continue
                if _auth_type(event) == "authorizationStateClosed":
                    self.closed.set()
        self.closed.set()
        for client in list(self.clients.values()):
            self.drop(client)
        if self.listener is not None:
            self.sel.unregister(self.listener)
            self.listener.close()
            try:
                os.unlink(SOCKET)
            except OSError:
                pass

    # ---------------------------------------------------------------- TDLib

    def td_send(self, query, client=None, rid=None, transform=None, failed=None):
        if self.td is None:
            if client is not None:
                self.respond_error(client, rid, "Telegram is not available")
            return
        extra = self.next_extra
        self.next_extra += 1
        # A request with no client but a transform is the service's own: its answer is
        # handed to the transform instead of a socket.
        if client is not None or transform is not None:
            self.pending[extra] = (client, rid, transform, failed)
        query = dict(query)
        query["@extra"] = extra
        self.td.send(query)

    def process_events(self):
        while True:
            try:
                event = self.events.get_nowait()
            except queue.Empty:
                return
            self.handle_td(event)

    def handle_td(self, event):
        if self.td is not None and event.get("@client_id") not in (None, self.td.client_id):
            return
        extra = event.get("@extra")
        if isinstance(extra, int) and extra in self.pending:
            client, rid, transform, failed = self.pending.pop(extra)
            if client is None:
                # The service's own request (often the first step of a command): an error goes to
                # `failed`, so whoever is waiting still hears back.
                try:
                    if event.get("@type") != "error":
                        transform(event)
                    elif failed is not None:
                        failed(event)
                except Exception:   # a malformed answer must not take the service down
                    pass
                return
            if client.sock.fileno() in self.clients:
                if event.get("@type") == "error":
                    self.respond_error(client, rid, model._str(event.get("message"), 200), model._int(event.get("code")))
                else:
                    try:
                        result = transform(event) if transform else {}
                    except BadRequest as e:
                        self.respond_error(client, rid, str(e))
                        return
                    except Exception:   # a malformed answer must not take the service down
                        result = {}
                    if result is not DEFERRED:
                        self.respond(client, rid, result)
            return
        if event.get("@type") == "updateAuthorizationState":
            self.on_auth(event.get("authorization_state"))
            return
        if event.get("@type") == "updateNotificationGroup":
            self.on_notification_group(event)
        for out in self.state.apply(event):
            if out.get("event") == "call":
                self.on_call(out["call"])
            self.broadcast(out)

    def on_call(self, call):
        """Calls cannot be answered here -- TDLib brings no voice engine -- so an incoming one is
        announced, to be taken in another Telegram app, and the note goes when the call ends."""
        if call["outgoing"]:
            return
        if call["state"] == "pending":
            kind = "video call" if call["video"] else "call"
            self.notifier.show(call["userId"], call["name"] or "Someone", f"Incoming {kind}: answer it in another Telegram app")
        elif call["state"] in ("ended", "failed"):
            self.notifier.withdraw(call["userId"])

    def load_stories(self, page=0):
        """The chats with active stories in the main list arrive as updates, a page per call."""
        if page < STORY_PAGES:
            self.td_send({"@type": "loadActiveStories", "story_list": {"@type": "storyListMain"}},
                         transform=lambda _event: self.load_stories(page + 1), failed=lambda _event=None: None)

    def on_auth(self, value):
        kind = model._obj(value).get("@type")
        if kind == "authorizationStateWaitTdlibParameters":
            self.send_parameters()
        elif kind == "authorizationStateReady":
            self.set_auth({"state": "ready"})
            self.td_send({"@type": "loadChats", "chat_list": {"@type": "chatListMain"}, "limit": 100})
            self.td_send({"@type": "getMe"}, transform=self.on_me)
            self.load_stories()
            # TDLib's notification groups: it applies mutes, exceptions and mentions itself,
            # and removes a notification once its messages are read on any device.
            self.td_send({"@type": "setOption", "name": "notification_group_count_max",
                          "value": {"@type": "optionValueInteger", "value": NOTIFICATION_GROUPS}})
        elif kind == "authorizationStateClosed":
            if self.stopping:
                self.closed.set()
                return
            # Logged out or the session was terminated elsewhere: start over, signed out.
            self.state = model.State(td.MEDIA_ROOTS)
            self.set_auth({"state": "starting"})
            self.td.new_client()
            self.td_send({"@type": "getOption", "name": "version"})
        else:
            self.set_auth(self.with_qr(model.auth_view(value)))

    def send_parameters(self):
        try:
            credentials = self.keyring.load_credentials()
            if credentials is None:
                self.set_auth({"state": "needCredentials"})
                return
            key = self.keyring.database_key()
            query = self.keyring.tdlib_parameters(credentials[0], credentials[1], key, VERSION)
        except (td.TdUnavailable, safe.UnsafeError, OSError) as e:
            self.set_auth({"state": "error", "reason": str(e)[:200]})
            return
        self.td_send(query)

    def on_notification_group(self, update):
        chat_id = model._int(update.get("chat_id"))
        if not chat_id:
            return
        total = model._int(update.get("total_count"))
        added = [model._obj(n, "notification") for n in model._list(update.get("added_notifications"), 100)]
        loud = [n for n in added if n and n.get("is_silent") is not True
                and model._obj(n.get("type")).get("@type") == "notificationTypeNewMessage"]
        if not loud:
            if total == 0:
                self.notifier.withdraw(chat_id)
            return
        kind = model._obj(max(loud, key=lambda n: model._int(n.get("id"))).get("type"))
        message = self.state.message(kind.get("message"))
        chat = self.state.chats.get(chat_id)
        title = chat["title"] if chat else ""
        if total > 1:
            title = f"{title} ({total})"
        if message is None or kind.get("show_preview") is not True:
            body = "New message"
        else:
            body = model.preview_text(message["content"])
            if chat and chat["kind"] != "private" and message["senderName"]:
                body = f"{message['senderName']}: {body}"
        self.notifier.show(chat_id, title, body)

    def on_notification_action(self, chat_id, action):
        if action == "reply":
            self.summon_quick_reply(chat_id)
        else:
            self.open_chat(chat_id, False)
            self.launch_window()

    def summon_quick_reply(self, chat_id):
        """Reply opens the quick-reply overlay on that chat. The overlay lives in Omarchy's shell;
        when that is not there, the window opens on the chat with its composer focused instead."""
        def fallback():
            self.open_chat(chat_id, True)
            self.launch_window()
        self.spawn([OMARCHY_SHELL, "shell", "summon", PLUGIN_ID, json.dumps({"chatId": chat_id})], fallback,
                   timeout=HELPER_TIMEOUT)

    def open_chat(self, chat_id, reply):
        """Tell the window to open a chat, or keep the request for the window that starts next."""
        target = {"chatId": chat_id, "reply": reply}
        windows = [c for c in self.clients.values() if c.window]
        self.pending_open = None if windows else (time.monotonic(), target)
        for client in windows:
            self.send_to(client, dict({"event": "open"}, **target))

    def launch_window(self):
        """`omagram`, in its own session with no terminal: it focuses the open window or starts one."""
        self.spawn(["/usr/bin/python3", str(pathlib.Path(__file__).resolve().parent / "omagram")])

    def spawn(self, argv, fallback=None, timeout=None):
        """A detached helper: its own session, no terminal, no inherited descriptors (TDLib's
        sockets and database stay here), no loader or Claude variables; an argv list, never a
        shell. `fallback` runs if it cannot start, fails, or outlives `timeout` seconds."""
        proc = self.start_helper(argv)
        if proc is None:
            if fallback:
                fallback()
            return
        self.children[proc.pid] = (proc, fallback, time.monotonic() + timeout if timeout else None)

    def start_helper(self, argv):
        env = {k: v for k, v in os.environ.items() if not k.startswith(("LD_", "PYTHON", "CLAUDE"))}
        env["PATH"] = safe.SAFE_PATH
        try:
            return subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True)
        except OSError:
            return None

    def background(self, work, done):
        """Slow work (ffmpeg) off the loop; `done(result, error)` then runs back on the loop."""
        self.jobs += 1

        def run():
            try:
                result, error = work(), None
            except Exception as e:   # handed to `done`, never lost in the thread
                result, error = None, e
            self.tasks.put((done, result, error))
            self.wake()
        threading.Thread(target=run, daemon=True).start()

    def run_tasks(self):
        while True:
            try:
                done, result, error = self.tasks.get_nowait()
            except queue.Empty:
                return
            self.jobs -= 1
            try:
                done(result, error)
            except Exception:
                pass

    def reap_children(self):
        now = time.monotonic()
        for pid, (proc, fallback, deadline) in list(self.children.items()):
            status = proc.poll()
            if status is None and deadline is not None and now > deadline:
                try:
                    os.killpg(pid, signal.SIGKILL)
                except OSError:
                    pass
                status = proc.wait()
            if status is None:
                continue
            del self.children[pid]
            if fallback and status != 0:
                fallback()

    def on_me(self, user):
        uid = model._int(user.get("id"))
        if not uid:
            return
        self.state.me_id = uid
        self.state.apply({"@type": "updateUser", "user": user})
        self.broadcast({"event": "me", "meId": uid})

    def set_auth(self, auth):
        self.auth = auth
        self.broadcast({"event": "auth", "auth": auth})

    def with_qr(self, auth):
        """Signing in with a QR code: the link Telegram gives, drawn as a PNG for another device to
        scan. qrencode reads the link on stdin, never from its command line. No picture when the link
        is not a login link or qrencode is missing."""
        link = auth.get("link", "")
        if auth.get("state") != "qr" or not isinstance(link, str) or not QR_LINK.fullmatch(link):
            return auth
        try:
            r = safe.run(["qrencode", "--type=PNG", "--size=8", "--margin=2", "--output=-"], input=link,
                         timeout=HELPER_TIMEOUT, max_output=QR_PNG_MAX)
        except (safe.UnsafeError, OSError):
            return dict(auth, image="")
        png = r.stdout if r.ok and r.stdout.startswith(b"\x89PNG\r\n\x1a\n") else b""
        return dict(auth, image=("data:image/png;base64," + base64.b64encode(png).decode("ascii")) if png else "")

    # ---------------------------------------------------------------- sockets

    def accept(self):
        try:
            conn, _ = self.listener.accept()
        except (BlockingIOError, OSError):
            return
        try:
            creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
            _, uid, _ = struct.unpack("3i", creds)
        except OSError:
            conn.close()
            return
        if uid != os.getuid() or len(self.clients) >= CLIENTS_MAX:
            conn.close()
            return
        conn.setblocking(False)
        client = Client(conn)
        self.clients[conn.fileno()] = client
        self.sel.register(conn, selectors.EVENT_READ, client)

    def drop(self, client):
        if client is self.focus_client:   # a window that closed is not reading its chat any more
            self.focus_client = None
            self.notifier.focus(0)
        fd = client.sock.fileno()
        if fd in self.clients:
            del self.clients[fd]
            try:
                self.sel.unregister(client.sock)
            except (KeyError, ValueError):
                pass
        for extra in [e for e, entry in self.pending.items() if entry[0] is client]:
            del self.pending[extra]
        client.sock.close()

    def on_socket(self, client, mask):
        if mask & selectors.EVENT_WRITE:
            self.flush(client)
        if mask & selectors.EVENT_READ:
            try:
                chunk = client.sock.recv(65536)
            except BlockingIOError:
                return
            except OSError:
                self.drop(client)
                return
            if not chunk:
                self.drop(client)
                return
            client.inbox += chunk
            while True:
                newline = client.inbox.find(b"\n")
                if newline < 0:
                    break
                line = bytes(client.inbox[:newline])
                del client.inbox[:newline + 1]
                if len(line) > LINE_MAX:
                    self.drop(client)
                    return
                self.handle_line(client, line)
                if client.sock.fileno() not in self.clients:
                    return
            if len(client.inbox) > LINE_MAX:
                self.drop(client)

    def send_to(self, client, value):
        data = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8") + b"\n"
        if len(client.outbox) + len(data) > OUTBOX_MAX:
            self.drop(client)   # not reading: better a reconnect than unbounded memory
            return
        client.outbox += data
        self.flush(client)

    def flush(self, client):
        if client.sock.fileno() not in self.clients:
            return
        try:
            while client.outbox:
                sent = client.sock.send(client.outbox)
                del client.outbox[:sent]
        except BlockingIOError:
            pass
        except OSError:
            self.drop(client)
            return
        events = selectors.EVENT_READ | (selectors.EVENT_WRITE if client.outbox else 0)
        try:
            self.sel.modify(client.sock, events, client)
        except (KeyError, ValueError):
            pass

    def broadcast(self, value):
        for client in list(self.clients.values()):
            self.send_to(client, value)

    def respond(self, client, rid, result):
        self.send_to(client, {"id": rid, "ok": True, "result": result})

    def respond_error(self, client, rid, message, code=0):
        self.send_to(client, {"id": rid, "ok": False, "error": message or "failed", "code": code})

    # ---------------------------------------------------------------- requests

    def handle_line(self, client, line):
        try:
            request = safe.loads(line, **REQUEST_LIMITS)
            # Lone surrogates parse as JSON but are not text; TDLib's encoder would choke on them.
            json.dumps(request, ensure_ascii=False).encode("utf-8")
        except (ValueError, UnicodeError, RecursionError, safe.UnsafeError):
            self.respond_error(client, None, "not a JSON request")
            return
        if not isinstance(request, dict):
            self.respond_error(client, None, "not a request")
            return
        rid = request.get("id")
        if isinstance(rid, bool) or not isinstance(rid, int):
            self.respond_error(client, None, "id must be an integer")
            return
        cmd = request.get("cmd")
        args = request.get("args", {})
        handler = COMMANDS.get(cmd) if isinstance(cmd, str) else None
        if handler is None or not isinstance(args, dict):
            self.respond_error(client, rid, "unknown command")
            return
        name, needs_ready = handler
        if needs_ready and self.auth.get("state") != "ready":
            self.respond_error(client, rid, "not signed in")
            return
        try:
            getattr(self, name)(client, rid, args)
        except BadRequest as e:
            self.respond_error(client, rid, str(e))
        except Exception:   # one bad request must never take the service, and the session, down
            self.respond_error(client, rid, "the request failed")

    def cmd_hello(self, client, rid, args):
        target = None
        if args.get("window") is True:
            client.window = True
            if self.pending_open and time.monotonic() - self.pending_open[0] < OPEN_TTL:
                target = self.pending_open[1]
            self.pending_open = None
        answer = {"version": VERSION, "auth": self.auth, "meId": self.state.me_id,
                  "chats": self.state.chat_list("main", 100), "open": target,
                  "folders": self.state.folders, "mainPosition": self.state.main_position,
                  "settings": self.prefs, "globalStatus": self.global_status, "calls": list(self.state.calls.values())}
        if client.window:
            answer["allChats"] = self.state.all_chats()   # the window's tabs need every list
            answer["stories"] = self.state.story_list()
        self.respond(client, rid, answer)

    def found_messages(self, event):
        found = (self.state.message(m) for m in model._list(event.get("messages"), 100))
        return [m for m in found if m]

    def cmd_chats_search(self, client, rid, args):
        query = arg_str(args, "query", QUERY_MAX)
        limit = arg_int(args, "limit", 1, 100, 30)
        server = args.get("server") is True

        def found(event):
            ids = [model._int(i) for i in model._list(event.get("chat_ids"), 100)]
            views = (self.state.chat_view(i) for i in ids if i)
            return {"query": query, "server": server, "chats": [v for v in views if v]}
        # Groups, channels and bots anyone can find by name: the ones you are not in yet.
        if args.get("public") is True:
            self.td_send({"@type": "searchPublicChats", "query": query, "type_filter": None}, client, rid, found)
            return
        self.td_send({"@type": "searchChatsOnServer" if server else "searchChats", "query": query,
                      "type_filter": None, "limit": limit}, client, rid, found)

    def cmd_messages_search(self, client, rid, args):
        query = arg_str(args, "query", QUERY_MAX)
        limit = arg_int(args, "limit", 1, 100, 30)
        if args.get("chatId") is not None:
            chat_id = arg_int(args, "chatId")
            request = {"@type": "searchChatMessages", "chat_id": chat_id, "topic_id": None, "query": query,
                       "sender_id": None, "from_message_id": arg_int(args, "fromMessageId", 0, None, 0),
                       "offset": 0, "limit": limit, "filter": None}

            def found(event):
                return {"query": query, "chatId": chat_id, "messages": self.found_messages(event),
                        "total": model._int(event.get("total_count")),
                        "nextFromMessageId": model._int(event.get("next_from_message_id"))}
        else:
            offset = args.get("offset", "")
            if not isinstance(offset, str) or len(offset) > OFFSET_MAX:
                raise BadRequest("offset is the text a previous search returned")
            request = {"@type": "searchMessages", "chat_list": None, "query": query, "offset": offset,
                       "limit": limit, "filter": None, "chat_type_filter": None, "min_date": 0, "max_date": 0}

            def found(event):
                return {"query": query, "chatId": 0, "messages": self.found_messages(event),
                        "total": model._int(event.get("total_count")),
                        "nextOffset": model._str(event.get("next_offset"), OFFSET_MAX)}
        self.td_send(request, client, rid, found)

    def cmd_chat_pin(self, client, rid, args):
        _, chat_list = arg_list(args)
        pinned = args.get("pinned")
        if not isinstance(pinned, bool):
            raise BadRequest("pinned must be true or false")
        self.td_send({"@type": "toggleChatIsPinned", "chat_list": chat_list,
                      "chat_id": arg_int(args, "chatId"), "is_pinned": pinned}, client, rid)

    def cmd_chat_archive(self, client, rid, args):
        archived = args.get("archived")
        if not isinstance(archived, bool):
            raise BadRequest("archived must be true or false")
        target = {"@type": "chatListArchive" if archived else "chatListMain"}

        def moved(event):
            # TDLib reports a chat's place in a list only once that list is loaded: until the
            # archive is, a chat moved there has no position anywhere and would vanish.
            self.td_send({"@type": "loadChats", "chat_list": target, "limit": 100})
            return {}
        self.td_send({"@type": "addChatToList", "chat_id": arg_int(args, "chatId"), "chat_list": target},
                     client, rid, moved)

    # ---------------------------------------------------------------- what you can do with messages

    def cmd_message_forward(self, client, rid, args):
        self.td_send({"@type": "forwardMessages", "chat_id": arg_int(args, "chatId"), "topic_id": self.topic_of(args),
                      "from_chat_id": arg_int(args, "fromChatId"), "message_ids": arg_ids(args, "messageIds"),
                      "options": self.send_options(args), "send_copy": args.get("sendCopy") is True, "remove_caption": False},
                     client, rid, lambda event: {"count": len(model._list(event.get("messages"), 100))})

    def cmd_message_properties(self, client, rid, args):
        self.td_send({"@type": "getMessageProperties", "chat_id": arg_int(args, "chatId"),
                      "message_id": arg_int(args, "messageId", 1)},
                     client, rid, lambda event: {name: event.get(key) is True for key, name in PROPERTIES.items()})

    def cmd_message_link(self, client, rid, args):
        self.td_send({"@type": "getMessageLink", "chat_id": arg_int(args, "chatId"), "message_id": arg_int(args, "messageId", 1),
                      "media_timestamp": 0, "checklist_task_id": 0, "poll_option_id": "", "for_album": False,
                      "in_message_thread": False},
                     client, rid, lambda event: {"link": model._str(event.get("link"), model.URL_MAX),
                                                 "public": event.get("is_public") is True})

    def cmd_message_pin(self, client, rid, args):
        chat_id, message_id = arg_int(args, "chatId"), arg_int(args, "messageId", 1)
        pinned = args.get("pinned")
        if pinned is True:
            query = {"@type": "pinChatMessage", "chat_id": chat_id, "message_id": message_id,
                     "disable_notification": args.get("notify") is not True, "only_for_self": args.get("forSelf") is True}
        elif pinned is False:
            query = {"@type": "unpinChatMessage", "chat_id": chat_id, "message_id": message_id}
        else:
            raise BadRequest("pinned must be true or false")
        self.td_send(query, client, rid)

    def cmd_chat_pinned(self, client, rid, args):
        self.td_send({"@type": "getChatPinnedMessage", "chat_id": arg_int(args, "chatId")},
                     client, rid, lambda event: {"message": self.state.message(event)})

    def cmd_reaction_set(self, client, rid, args):
        base = {"chat_id": arg_int(args, "chatId"), "message_id": arg_int(args, "messageId", 1),
                "reaction_type": {"@type": "reactionTypeEmoji", "emoji": arg_str(args, "emoji", 16)}}
        chosen = args.get("chosen")
        if chosen is True:
            query = dict(base, **{"@type": "addMessageReaction", "is_big": False, "update_recent_reactions": True})
        elif chosen is False:
            query = dict(base, **{"@type": "removeMessageReaction"})
        else:
            raise BadRequest("chosen must be true or false")
        self.td_send(query, client, rid)

    def cmd_reactions_available(self, client, rid, args):
        def available(event):
            seen, emoji = set(), []
            for group in ("top_reactions", "recent_reactions", "popular_reactions"):
                for raw in model._list(event.get(group), 100):
                    r = model._obj(raw, "availableReaction")
                    kind = model._obj(r.get("type"))
                    value = model._str(kind.get("emoji"), 16) if kind.get("@type") == "reactionTypeEmoji" else ""
                    if value and value not in seen and r.get("needs_premium") is not True:
                        seen.add(value)
                        emoji.append(value)
            return {"emoji": emoji[:48]}
        self.td_send({"@type": "getMessageAvailableReactions", "chat_id": arg_int(args, "chatId"),
                      "message_id": arg_int(args, "messageId", 1), "row_size": 8}, client, rid, available)

    def cmd_button_callback(self, client, rid, args):
        data = args.get("data")
        if not isinstance(data, str) or not CALLBACK_DATA.fullmatch(data):
            raise BadRequest("that is not a button's data")
        self.td_send({"@type": "getCallbackQueryAnswer", "chat_id": arg_int(args, "chatId"),
                      "message_id": arg_int(args, "messageId", 1),
                      "payload": {"@type": "callbackQueryPayloadData", "data": data}},
                     client, rid, lambda event: {"text": model._str(event.get("text"), 200),
                                                 "alert": event.get("show_alert") is True,
                                                 "url": model._str(event.get("url"), model.URL_MAX)})

    def cmd_poll_vote(self, client, rid, args):
        options = args.get("optionIds")
        if (not isinstance(options, list) or len(options) > model.POLL_OPTIONS_MAX
                or any(isinstance(o, bool) or not isinstance(o, int) or not 0 <= o < model.POLL_OPTIONS_MAX for o in options)):
            raise BadRequest("optionIds is a list of option numbers")
        self.td_send({"@type": "setPollAnswer", "chat_id": arg_int(args, "chatId"), "message_id": arg_int(args, "messageId", 1),
                      "option_ids": options}, client, rid)

    def cmd_chat_action(self, client, rid, args):
        action = args.get("action")
        if action not in SEND_ACTIONS:
            raise BadRequest("that is not a chat action")
        self.td_send({"@type": "sendChatAction", "chat_id": arg_int(args, "chatId"), "topic_id": self.topic_of(args),
                      "business_connection_id": "", "action": {"@type": SEND_ACTIONS[action]}}, client, rid)

    def cmd_chat_draft(self, client, rid, args):
        text = args.get("text", "")
        if not isinstance(text, str) or len(text) > TEXT_MAX:
            raise BadRequest(f"a draft is text of at most {TEXT_MAX} characters")
        draft = None
        if text.strip():
            draft = {"@type": "draftMessage", "reply_to": self.reply_to(args), "date": 0, "effect_id": 0,
                     "suggested_post_info": None,
                     "content": {"@type": "draftMessageContentText", "link_preview_options": None,
                                 "text": {"@type": "formattedText", "text": text, "entities": []}}}
        self.td_send({"@type": "setChatDraftMessage", "chat_id": arg_int(args, "chatId"), "topic_id": self.topic_of(args),
                      "draft_message": draft}, client, rid)

    def cmd_chat_mute(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        chat = self.state.chats.get(chat_id)
        if chat is None:
            raise BadRequest("unknown chat")
        mute_for = arg_int(args, "muteFor", -1, MUTE_FOREVER)   # -1: whatever the default for such chats is
        settings = dict(chat["notification"], use_default_mute_for=mute_for < 0, mute_for=max(0, mute_for))
        self.td_send({"@type": "setChatNotificationSettings", "chat_id": chat_id, "notification_settings": settings},
                     client, rid)

    def cmd_chat_next_mention(self, client, rid, args):
        def found(event):
            ids = [i for i in (model._int(model._obj(m, "message").get("id")) for m in model._list(event.get("messages"), 100)) if i]
            return {"messageId": min(ids) if ids else 0}
        self.td_send({"@type": "searchChatMessages", "chat_id": arg_int(args, "chatId"), "topic_id": self.topic_of(args), "query": "",
                      "sender_id": None, "from_message_id": 0, "offset": 0, "limit": 100,
                      "filter": {"@type": "searchMessagesFilterUnreadMention"}}, client, rid, found)

    def cmd_chat_read_mentions(self, client, rid, args):
        topic = self.topic_of(args)
        if topic is None:
            self.td_send({"@type": "readAllChatMentions", "chat_id": arg_int(args, "chatId")}, client, rid)
        elif topic["@type"] == "messageTopicForum":
            self.td_send({"@type": "readAllForumTopicMentions", "chat_id": arg_int(args, "chatId"),
                          "forum_topic_id": topic["forum_topic_id"]}, client, rid)
        else:
            raise BadRequest("Telegram reads mentions for a whole chat or topic, not for one thread")

    # ---------------------------------------------------------------- links, people, files

    def cmd_link_open(self, client, rid, args):
        """Where a link leads: a chat or message inside Telegram, an invite, or the web."""
        url = arg_str(args, "url", model.URL_MAX)
        if not re.match(r"(?i)^(https?|tg)://", url):
            raise BadRequest("only web and Telegram links open")
        if not TELEGRAM_LINK.match(url):
            self.respond(client, rid, {"kind": "external", "url": url})
            return

        def external(_event=None):
            self.respond(client, rid, {"kind": "external", "url": url})

        def chat_answer(chat, **extra):
            return dict({"kind": "chat", "chatId": model._int(chat.get("id"))}, **extra)

        def classified(event):
            t = event.get("@type")
            if t == "internalLinkTypePublicChat":
                self.td_send({"@type": "searchPublicChat", "username": model._str(event.get("chat_username"), 64)},
                             client, rid, chat_answer)
            elif t == "internalLinkTypeBotStart":
                parameter = model._str(event.get("start_parameter"), 64)
                self.td_send({"@type": "searchPublicChat", "username": model._str(event.get("bot_username"), 64)},
                             client, rid, lambda chat: chat_answer(chat, botStart=parameter))
            elif t == "internalLinkTypeMessage":
                self.td_send({"@type": "getMessageLinkInfo", "url": model._str(event.get("url"), model.URL_MAX)}, client, rid,
                             lambda info: {"kind": "chat", "chatId": model._int(info.get("chat_id")),
                                           "messageId": model._int(model._obj(info.get("message"), "message").get("id"))})
            elif t == "internalLinkTypeChatInvite":
                link = model._str(event.get("invite_link"), model.URL_MAX)
                self.td_send({"@type": "checkChatInviteLink", "invite_link": link}, client, rid,
                             lambda info: {"kind": "invite", "link": link, "title": model._str(info.get("title"), model.TITLE_MAX),
                                           "members": max(0, model._int(info.get("member_count"))),
                                           "chatId": model._int(info.get("chat_id"))})
            else:
                external()
        self.td_send({"@type": "getInternalLinkType", "link": url}, transform=classified, failed=external)

    def cmd_chat_join_link(self, client, rid, args):
        self.td_send({"@type": "joinChatByInviteLink", "invite_link": arg_str(args, "link", model.URL_MAX)},
                     client, rid, join_result)

    def cmd_bot_start(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        chat = self.state.chats.get(chat_id)
        if chat is None or not chat["userId"]:
            raise BadRequest("that is not a chat with a bot")
        self.td_send({"@type": "sendBotStartMessage", "bot_user_id": chat["userId"], "chat_id": chat_id,
                      "parameter": arg_str(args, "parameter", 64, 0)}, client, rid, self.state.message)

    def cmd_user_chat(self, client, rid, args):
        self.td_send({"@type": "createPrivateChat", "user_id": arg_int(args, "userId", 1), "force": False},
                     client, rid, lambda chat: {"chatId": model._int(chat.get("id"))})

    def cmd_username_chat(self, client, rid, args):
        username = arg_str(args, "username", 64).lstrip("@")
        if not USERNAME.fullmatch(username):
            raise BadRequest("that is not a username")
        self.td_send({"@type": "searchPublicChat", "username": username},
                     client, rid, lambda chat: {"chatId": model._int(chat.get("id"))})

    def downloaded_path(self, event):
        f = model._obj(event, "file")
        local = model._obj(f.get("local"))
        if local.get("is_downloading_completed") is not True:
            raise BadRequest("the file is not downloaded yet")
        path = model.local_path(local.get("path"), td.MEDIA_ROOTS)
        if not path:
            raise BadRequest("that file is not one of Omagram's")
        return path

    def cmd_file_open(self, client, rid, args):
        def opened(event):
            self.spawn([XDG_OPEN, self.downloaded_path(event)], timeout=HELPER_TIMEOUT * 3)
            return {}
        self.td_send({"@type": "getFile", "file_id": arg_int(args, "fileId", 1, INT32_MAX)}, client, rid, opened)

    def cmd_file_save(self, client, rid, args):
        name = download_name(args.get("fileName"))

        def located(event):
            path = self.downloaded_path(event)
            if self.jobs >= JOBS_MAX:
                raise BadRequest("still saving an earlier file")

            def done(saved, error):
                if error is not None:
                    self.respond_error(client, rid, "the file could not be saved to Downloads")
                else:
                    self.respond(client, rid, {"path": saved})
            self.background(lambda: str(copy_out(path, DOWNLOADS, name)), done)
            return DEFERRED
        self.td_send({"@type": "getFile", "file_id": arg_int(args, "fileId", 1, INT32_MAX)}, client, rid, located)

    def cmd_clipboard_image(self, client, rid, args):
        """An image on the clipboard, saved privately to send; "" when there is none."""
        try:
            offered = clipboard_types()
            for mime, suffix in CLIPBOARD_TYPES:
                if mime not in offered:
                    continue
                data = clipboard_data(mime)
                if data is None:
                    break
                path = media.new_path("paste", suffix)
                safe.write_file(path, data, mode=0o600)
                self.respond(client, rid, {"path": str(path)})
                return
        except (safe.UnsafeError, OSError):
            pass
        self.respond(client, rid, {"path": ""})

    # ---------------------------------------------------------------- a chat's info, members and shared media

    def cmd_chat_info(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        chat = self.state.chats.get(chat_id)
        if chat is None:
            raise BadRequest("unknown chat")
        base = {"chatId": chat_id, "kind": chat["kind"]}

        def invite(event):
            return model._str(model._obj(event.get("invite_link"), "chatInviteLink").get("invite_link"), model.URL_MAX)

        if chat["userId"]:
            user = self.state.users.get(chat["userId"], {})

            def person(event):
                bot = model._obj(event.get("bot_info"), "botInfo")
                secret = self.state.secret_chats.get(chat["secretChatId"], {}) if chat["secretChatId"] else {}
                return dict(base, userId=chat["userId"], username=user.get("username", ""), phone=user.get("phone", ""),
                            bio=model.formatted_view(event.get("bio")),
                            botDescription=model._str(bot.get("description"), model.DESCRIPTION_MAX),
                            commonGroups=max(0, model._int(event.get("group_in_common_count"))),
                            keyHash=secret.get("keyHash", ""))
            self.td_send({"@type": "getUserFullInfo", "user_id": chat["userId"]}, client, rid, person)
        elif chat["basicGroupId"]:
            def group(event):
                members = self.member_views(event)
                return dict(base, description=model._str(event.get("description"), model.DESCRIPTION_MAX),
                            memberCount=len(members), members=members, canGetMembers=True, inviteLink=invite(event))
            self.td_send({"@type": "getBasicGroupFullInfo", "basic_group_id": chat["basicGroupId"]}, client, rid, group)
        elif chat["supergroupId"]:
            known = self.state.supergroups.get(chat["supergroupId"], {})

            def supergroup(event):
                return dict(base, description=model._str(event.get("description"), model.DESCRIPTION_MAX),
                            memberCount=max(0, model._int(event.get("member_count"))) or known.get("memberCount", 0),
                            members=[], canGetMembers=event.get("can_get_members") is True, inviteLink=invite(event),
                            username=known.get("username", ""), linkedChatId=model._int(event.get("linked_chat_id")))
            self.td_send({"@type": "getSupergroupFullInfo", "supergroup_id": chat["supergroupId"]}, client, rid, supergroup)
        else:
            self.respond(client, rid, base)

    def cmd_chat_join(self, client, rid, args):
        """Joins a group or channel you opened by its name or a link. A basic group you left takes
        someone in it to add you back."""
        chat_id = arg_int(args, "chatId")
        chat = self.state.chats.get(chat_id)
        if chat is None or not chat["supergroupId"]:
            raise BadRequest("only public groups and channels can be joined")
        self.td_send({"@type": "joinChat", "chat_id": chat_id}, client, rid, lambda event: join_result(event, chat_id))

    def cmd_chat_mentions(self, client, rid, args):
        """Who can be mentioned in a group, matching what is typed after @ (a name or username)."""
        chat_id = arg_int(args, "chatId")
        chat = self.state.chats.get(chat_id)
        query = args.get("query", "")
        if not isinstance(query, str) or len(query) > MENTION_QUERY_MAX:
            raise BadRequest("query is text")
        if chat is None or not (chat["basicGroupId"] or chat["supergroupId"]):
            self.respond(client, rid, {"chatId": chat_id, "people": []})
            return

        def people(event):
            found = []
            for member in self.member_views(event):
                if member["type"] != "user" or member["id"] == self.state.me_id:
                    continue
                user = self.state.users.get(member["id"], {})
                found.append({"userId": member["id"], "name": member["name"], "username": user.get("username", ""),
                              "bot": member["bot"]})
            return {"chatId": chat_id, "people": found[:MENTIONS_MAX]}
        self.td_send({"@type": "searchChatMembers", "chat_id": chat_id, "query": query, "limit": MENTIONS_MAX,
                      "filter": {"@type": "chatMembersFilterMention", "topic_id": self.topic_of(args)}}, client, rid, people)

    def cmd_chat_commands(self, client, rid, args):
        """The commands of a chat's bots, for suggestions after /."""
        chat_id = arg_int(args, "chatId")
        chat = self.state.chats.get(chat_id)
        if chat is None:
            raise BadRequest("unknown chat")

        def listed(bot_id, commands):
            bot = self.state.users.get(bot_id, {})
            out = []
            for raw in model._list(commands, BOT_COMMANDS_MAX):
                c = model._obj(raw, "botCommand")
                name = c.get("command")
                if isinstance(name, str) and BOT_COMMAND.fullmatch(name):
                    out.append({"command": name, "description": model._str(c.get("description"), model.DESCRIPTION_MAX),
                                "botId": bot_id, "bot": bot.get("username", "")})
            return out

        def of_bot(event):
            return {"chatId": chat_id, "commands": listed(chat["userId"], model._obj(event.get("bot_info"), "botInfo").get("commands"))}

        def of_group(event):
            out = []
            for raw in model._list(event.get("bot_commands"), BOT_COMMANDS_MAX):
                group = model._obj(raw, "botCommands")
                out.extend(listed(model._int(group.get("bot_user_id")), group.get("commands")))
            return {"chatId": chat_id, "commands": out[:BOT_COMMANDS_MAX]}

        if chat["userId"] and self.state.users.get(chat["userId"], {}).get("bot") and not chat["secretChatId"]:
            self.td_send({"@type": "getUserFullInfo", "user_id": chat["userId"]}, client, rid, of_bot)
        elif chat["basicGroupId"]:
            self.td_send({"@type": "getBasicGroupFullInfo", "basic_group_id": chat["basicGroupId"]}, client, rid, of_group)
        elif chat["supergroupId"]:
            self.td_send({"@type": "getSupergroupFullInfo", "supergroup_id": chat["supergroupId"]}, client, rid, of_group)
        else:
            self.respond(client, rid, {"chatId": chat_id, "commands": []})

    def member_views(self, event):
        found = (self.state.member_view(m) for m in model._list(event.get("members"), MEMBERS_MAX))
        return [m for m in found if m]

    def cmd_chat_members(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        chat = self.state.chats.get(chat_id)
        if chat is None or not (chat["basicGroupId"] or chat["supergroupId"]):
            raise BadRequest("that chat has no members to list")
        query = args.get("query", "")
        if not isinstance(query, str) or len(query) > QUERY_MAX:
            raise BadRequest("query is text")
        offset, limit = arg_int(args, "offset", 0, 100000, 0), arg_int(args, "limit", 1, MEMBERS_MAX, 50)

        def members(event):
            found = self.member_views(event)
            if chat["supergroupId"]:
                return {"chatId": chat_id, "members": found, "total": max(len(found), model._int(event.get("total_count")))}
            # A basic group's members all come at once, so they are searched and paged here.
            wanted = query.casefold()
            found = [m for m in found if wanted in m["name"].casefold()]
            return {"chatId": chat_id, "members": found[offset:offset + limit], "total": len(found)}

        if chat["supergroupId"]:
            wanted = {"@type": "supergroupMembersFilterSearch", "query": query} if query else {"@type": "supergroupMembersFilterRecent"}
            self.td_send({"@type": "getSupergroupMembers", "supergroup_id": chat["supergroupId"], "filter": wanted,
                          "offset": offset, "limit": limit}, client, rid, members)
        else:
            self.td_send({"@type": "getBasicGroupFullInfo", "basic_group_id": chat["basicGroupId"]}, client, rid, members)

    def cmd_chat_media(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        kind = args.get("filter")
        if kind not in MEDIA_FILTERS:
            raise BadRequest("filter is one of " + ", ".join(MEDIA_FILTERS))

        def found(event):
            return {"chatId": chat_id, "filter": kind, "messages": self.found_messages(event),
                    "total": max(0, model._int(event.get("total_count"))),
                    "nextFromMessageId": model._int(event.get("next_from_message_id"))}
        self.td_send({"@type": "searchChatMessages", "chat_id": chat_id, "topic_id": None, "query": "", "sender_id": None,
                      "from_message_id": arg_int(args, "fromMessageId", 0, None, 0), "offset": 0,
                      "limit": arg_int(args, "limit", 1, 100, 50), "filter": {"@type": MEDIA_FILTERS[kind]}},
                     client, rid, found)

    def cmd_chat_media_counts(self, client, rid, args):
        """How many photos, files, links and so on a chat has: one count each, answered together."""
        chat_id = arg_int(args, "chatId")
        counts, waiting = {}, set(MEDIA_FILTERS)

        def settle(kind, value):
            counts[kind] = value
            waiting.discard(kind)
            if not waiting and client.sock.fileno() in self.clients:
                self.respond(client, rid, {"chatId": chat_id, "counts": counts})

        for kind, name in MEDIA_FILTERS.items():
            self.td_send({"@type": "getChatMessageCount", "chat_id": chat_id, "topic_id": None, "filter": {"@type": name},
                          "return_local": False},
                         transform=lambda event, kind=kind: settle(kind, max(0, model._int(event.get("count")))),
                         failed=lambda event, kind=kind: settle(kind, 0))

    def cmd_chat_leave(self, client, rid, args):
        self.td_send({"@type": "leaveChat", "chat_id": arg_int(args, "chatId")}, client, rid)

    def cmd_chat_clear_history(self, client, rid, args):
