    "chat.archive": ("cmd_chat_archive", True),
}


def _auth_type(event):
    if not isinstance(event, dict) or event.get("@type") != "updateAuthorizationState":
        return None
    return model._obj(event.get("authorization_state")).get("@type")


def main(argv):
    if argv[1:] not in ([], ["--with-parent"]):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if argv[1:] == ["--with-parent"]:
        safe.die_with_parent()
    daemon = Daemon()
    try:
        if not daemon.acquire():
            return 0
    except (safe.UnsafeError, OSError) as e:
        print(f"omagramd: {e}", file=sys.stderr)
        return 1
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, daemon.stop)
    try:
        daemon.run()
    except (safe.UnsafeError, OSError) as e:
        print(f"omagramd: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
