#!/usr/bin/python3
"""omagramd -- Omagram's background service: one Telegram session, shared by every Omagram
surface (the app window, the bar panel, the overlay) over a private local socket.

  omagramd [--with-parent]

--with-parent: exit when the process that started it exits (the shell passes this).

The socket is $XDG_RUNTIME_DIR/omagram/omagram.sock, mode 0600 in a 0700 directory, and a
connection is served only if the kernel reports the peer is this same user. One instance
runs per login: a second one exits quietly.

Protocol: newline-delimited JSON. A request is {"id": <int>, "cmd": "<name>", "args": {...}};
its answer is {"id": <int>, "ok": true, "result": ...} or {"id": <int>, "ok": false,
"error": "..."}. Everything else the service sends is an event, {"event": "<name>", ...}.
Lines are capped at 64 KB in, a slow client's backlog at 16 MB out.

Login codes, passwords and the API credentials are handed straight to TDLib or the keyring:
they are never echoed back, logged or written anywhere.
"""
import fcntl
import hashlib
import json
import os
import pathlib
import queue
import re
import selectors
import signal
import socket
import stat
import struct
import sys
import threading
import time
import zlib

sys.dont_write_bytecode = True
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import plugin_safety as safe  # noqa: E402
import omagram_state as model  # noqa: E402
import omagram_td as td  # noqa: E402
import omagram_notify as notify  # noqa: E402

VERSION = "0.1.0"
RUN = pathlib.Path(safe.runtime_dir()) / "omagram"
SOCKET = RUN / "omagram.sock"
LOCK = RUN / "omagram.lock"

LINE_MAX = 64 * 1024
OUTBOX_MAX = 16 * 1024 * 1024
CLIENTS_MAX = 16
REQUEST_LIMITS = {"max_depth": 6, "max_items": 1024, "max_string": 16 * 1024}
TEXT_MAX = 4096
IDS_MAX = 100
CLOSE_TIMEOUT = 5.0

LOTTIE = pathlib.Path(safe.home_dir()) / ".cache/omagram/lottie"
# Telegram caps animated stickers at 64 KB compressed; a megabyte is far past any real one.
TGS_MAX = 1024 * 1024
LOTTIE_MAX = 16 * 1024 * 1024
LOTTIE_LIMITS = {"max_depth": 64, "max_items": 2_000_000, "max_string": 1024 * 1024}
FILE_ID_MAX = 2 ** 31 - 1
DOCUMENT_MAX = 2 * 1024 ** 3                        # Telegram's file limit without Premium
PHOTO_MAX = 10 * 1024 ** 2                          # larger images go as documents
PHOTO_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp")
CAPTION_MAX = 1024
STICKERS_MAX = 300
SET_ID = re.compile(r"-?[0-9]{1,20}")

PHONE = re.compile(r"\+?[0-9][0-9 ()-]{4,30}")
CODE = re.compile(r"[0-9]{3,10}")

LOG = print


class BadRequest(Exception):
    pass


def lottie_json(path):
    """The Lottie animation inside a TGS sticker (gzip-compressed JSON), written once to a
    private cache named by the sticker's hash. Returns that path, or "" for anything that is
    not a sane TGS. Inflation stops at LOTTIE_MAX, so a compression bomb costs nothing, and
    the JSON's shape is bounded before the UI's Lottie parser ever sees it."""
    try:
        blob = safe.read_file(path, TGS_MAX)
    except (safe.UnsafeError, OSError):
        return ""
    if not blob or blob[:2] != b"\x1f\x8b":
        return ""
    inflater = zlib.decompressobj(16 + zlib.MAX_WBITS)
    try:
        data = inflater.decompress(blob, LOTTIE_MAX + 1)
    except zlib.error:
        return ""
    if len(data) > LOTTIE_MAX or inflater.unconsumed_tail:
        return ""
    try:
        doc = safe.loads(data, **LOTTIE_LIMITS)
    except (ValueError, UnicodeDecodeError, safe.UnsafeError):
        return ""
    if not isinstance(doc, dict):
        return ""
    target = LOTTIE / (hashlib.sha256(blob).hexdigest() + ".json")
    if not os.path.isfile(target):
        try:
            safe.write_file(target, data, mode=0o600)
        except (safe.UnsafeError, OSError):
            return ""
    return str(target)


def local_upload(path):
    """A file you chose to send: an absolute path to a non-empty regular file you can read,
    within Telegram's size limit. Omagram's own database directory is never sent.
    Returns (real path, size)."""
    if not isinstance(path, str) or not path.startswith("/") or len(path) > 4096 or any(ord(c) < 32 for c in path):
        raise BadRequest("the file must be given as an absolute path")
    try:
        real = os.path.realpath(path)
        st = os.stat(real)
    except OSError:
        raise BadRequest("that file does not exist") from None
    if not stat.S_ISREG(st.st_mode):
        raise BadRequest("only regular files can be sent")
    database = str(td.DATABASE) + "/"
    if real == str(td.DATABASE) or real.startswith(database):
        raise BadRequest("Omagram's own database is not sent")
    if not os.access(real, os.R_OK):
        raise BadRequest("that file is not readable")
    if st.st_size == 0:
        raise BadRequest("that file is empty")
    if st.st_size > DOCUMENT_MAX:
        raise BadRequest("Telegram accepts files up to 2 GB")
    return real, st.st_size


NOTIFICATION_GROUPS = 10
QUERY_MAX = 256
OFFSET_MAX = 512
INT32_MAX = 2 ** 31 - 1
PLUGIN_ID = "reidenxerx.omagram"
OMARCHY_SHELL = "/usr/bin/omarchy-shell"
OPEN_TTL = 30.0   # seconds a notification's "open this chat" waits for a window to start


def arg_int(args, name, low=None, high=None, default=None):
    value = args.get(name, default)
    if isinstance(value, bool) or not isinstance(value, int):
        raise BadRequest(f"{name} must be an integer")
    if (low is not None and value < low) or (high is not None and value > high):
        raise BadRequest(f"{name} is out of range")
    return value


def arg_list(args, name="list"):
    """A chat list by its UI key -- main, archive or folder:<id> -- and as TDLib's ChatList."""
    key = args.get(name, "main")
    if not isinstance(key, str) or not re.fullmatch(r"main|archive|folder:[1-9][0-9]{0,9}", key):
        raise BadRequest(f"{name} is main, archive or folder:<id>")
    if key == "main":
        return key, {"@type": "chatListMain"}
    if key == "archive":
        return key, {"@type": "chatListArchive"}
    folder = int(key.split(":")[1])
    if folder > INT32_MAX:
        raise BadRequest(f"{name} is main, archive or folder:<id>")
    return key, {"@type": "chatListFolder", "chat_folder_id": folder}


def arg_str(args, name, max_len, min_len=1):
    value = args.get(name)
    if not isinstance(value, str) or not min_len <= len(value) <= max_len:
        raise BadRequest(f"{name} must be text of {min_len}-{max_len} characters")
    return value


def arg_ids(args, name):
    value = args.get(name)
    if not isinstance(value, list) or not 1 <= len(value) <= IDS_MAX:
        raise BadRequest(f"{name} must be a list of 1-{IDS_MAX} message ids")
    for item in value:
        if isinstance(item, bool) or not isinstance(item, int) or item <= 0:
            raise BadRequest(f"{name} must contain message ids")
    return value


class Client:
    __slots__ = ("sock", "inbox", "outbox", "window")

    def __init__(self, sock):
        self.sock = sock
        self.inbox = bytearray()
        self.outbox = bytearray()
        self.window = False   # Omagram's window (said so in hello), not the bar or a tool


class Daemon:
    def __init__(self, open_client=None, keyring=None, notifier_factory=None):
        self.open_client = open_client or td.open_client
        self.keyring = keyring or td
        self.notifier_factory = notifier_factory or (lambda on_action: notify.Notifier(notify.GioTransport, on_action))
        self.notifier = notify.Notifier(None, None)
        self.pending_open = None   # (monotonic time, {"chatId", "reply"}) for the next window
        self.children = {}   # detached helpers still running: pid -> what to do if they fail
        self.state = model.State(td.MEDIA_ROOTS)
        self.td = None
        self.auth = {"state": "starting"}
        self.clients = {}
        self.pending = {}
        self.next_extra = 1
        self.events = queue.Queue()
        self.stopping = False
        self.closed = threading.Event()
        self.sel = selectors.DefaultSelector()
        self.wake_r, self.wake_w = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        self.sel.register(self.wake_r, selectors.EVENT_READ, "wake")
        self.listener = None
        self.lock_fd = None

    # ---------------------------------------------------------------- lifecycle

    def acquire(self):
        """True if this is the only instance for this login."""
        safe.ensure_dir(RUN, 0o700)
        fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(fd)
            return False
        self.lock_fd = fd
        return True

    def listen(self):
        try:
            st = os.stat(SOCKET, follow_symlinks=False)
            if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid():
                os.unlink(SOCKET)   # left by an instance that is gone: we hold the lock
            else:
                raise safe.UnsafeError(f"{SOCKET} exists and is not our socket")
        except FileNotFoundError:
            pass
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
        old = os.umask(0o177)
        try:
            sock.bind(str(SOCKET))
        finally:
            os.umask(old)
        os.chmod(SOCKET, 0o600)
        sock.listen(8)
        sock.setblocking(False)
        self.listener = sock
        self.sel.register(sock, selectors.EVENT_READ, "listen")

    def wake(self):
        try:
            os.write(self.wake_w, b"!")
        except (BlockingIOError, OSError):
            pass

    def stop(self, *_):
        self.stopping = True
        self.wake()

    def start_td(self):
        try:
            self.td = self.open_client()
        except td.TdUnavailable as e:
            self.set_auth({"state": "noLibrary", "reason": str(e)})
            return
        threading.Thread(target=self.receive_loop, daemon=True).start()
        # Any request activates a new client; its answer is not needed.
        self.td_send({"@type": "getOption", "name": "version"})

    def receive_loop(self):
        while not self.stopping or not self.closed.is_set():
            event = self.td.receive(1.0)
            if event is not None:
                self.events.put(event)
                self.wake()
            elif self.stopping and self.closed.is_set():
                return

    def run(self):
        # Created on the thread that pumps it: Gio delivers bus signals to this context.
        self.notifier = self.notifier_factory(self.on_notification_action)
        self.listen()
        self.start_td()
        while not self.stopping:
            for key, mask in self.sel.select(timeout=0.25 if self.notifier.available else 1.0):
                if key.data == "wake":
                    self.drain_wake()
                elif key.data == "listen":
                    self.accept()
                else:
                    self.on_socket(key.data, mask)
            self.process_events()
            self.notifier.pump()
            self.reap_children()
        self.shutdown()

    def shutdown(self):
        if self.td is not None and not self.closed.is_set():
            # A clean close lets TDLib flush its database; waiting is bounded.
            self.td.send({"@type": "close"})
            deadline = time.monotonic() + CLOSE_TIMEOUT
            while not self.closed.is_set() and time.monotonic() < deadline:
                try:
                    event = self.events.get(timeout=0.2)
                except queue.Empty:
                    continue
                if _auth_type(event) == "authorizationStateClosed":
                    self.closed.set()
        self.closed.set()
        for client in list(self.clients.values()):
            self.drop(client)
        if self.listener is not None:
            self.sel.unregister(self.listener)
            self.listener.close()
            try:
                os.unlink(SOCKET)
            except OSError:
                pass

    # ---------------------------------------------------------------- TDLib

    def td_send(self, query, client=None, rid=None, transform=None):
        if self.td is None:
            if client is not None:
                self.respond_error(client, rid, "Telegram is not available")
            return
        extra = self.next_extra
        self.next_extra += 1
        # A request with no client but a transform is the service's own: its answer is
        # handed to the transform instead of a socket.
        if client is not None or transform is not None:
            self.pending[extra] = (client, rid, transform)
        query = dict(query)
        query["@extra"] = extra
        self.td.send(query)

    def process_events(self):
        while True:
            try:
                event = self.events.get_nowait()
            except queue.Empty:
                return
            self.handle_td(event)

    def handle_td(self, event):
        if self.td is not None and event.get("@client_id") not in (None, self.td.client_id):
            return
        extra = event.get("@extra")
        if isinstance(extra, int) and extra in self.pending:
            client, rid, transform = self.pending.pop(extra)
            if client is None:
                if event.get("@type") != "error":
                    try:
                        transform(event)
                    except Exception:   # a malformed answer must not take the service down
                        pass
                return
            if client.sock.fileno() in self.clients:
                if event.get("@type") == "error":
                    self.respond_error(client, rid, model._str(event.get("message"), 200), model._int(event.get("code")))
                else:
                    try:
                        result = transform(event) if transform else {}
                    except Exception:   # a malformed answer must not take the service down
                        result = {}
                    self.respond(client, rid, result)
            return
        if event.get("@type") == "updateAuthorizationState":
            self.on_auth(event.get("authorization_state"))
            return
        if event.get("@type") == "updateNotificationGroup":
            self.on_notification_group(event)
        for out in self.state.apply(event):
            self.broadcast(out)

    def on_auth(self, value):
        kind = model._obj(value).get("@type")
        if kind == "authorizationStateWaitTdlibParameters":
            self.send_parameters()
        elif kind == "authorizationStateReady":
            self.set_auth({"state": "ready"})
            self.td_send({"@type": "loadChats", "chat_list": {"@type": "chatListMain"}, "limit": 100})
            self.td_send({"@type": "getMe"}, transform=self.on_me)
            # TDLib's notification groups: it applies mutes, exceptions and mentions itself,
            # and removes a notification once its messages are read on any device.
            self.td_send({"@type": "setOption", "name": "notification_group_count_max",
                          "value": {"@type": "optionValueInteger", "value": NOTIFICATION_GROUPS}})
        elif kind == "authorizationStateClosed":
            if self.stopping:
                self.closed.set()
                return
            # Logged out or the session was terminated elsewhere: start over, signed out.
            self.state = model.State(td.MEDIA_ROOTS)
            self.set_auth({"state": "starting"})
            self.td.new_client()
            self.td_send({"@type": "getOption", "name": "version"})
        else:
            self.set_auth(model.auth_view(value))

    def send_parameters(self):
        try:
            credentials = self.keyring.load_credentials()
            if credentials is None:
                self.set_auth({"state": "needCredentials"})
                return
            key = self.keyring.database_key()
            query = self.keyring.tdlib_parameters(credentials[0], credentials[1], key, VERSION)
        except (td.TdUnavailable, safe.UnsafeError, OSError) as e:
            self.set_auth({"state": "error", "reason": str(e)[:200]})
            return
        self.td_send(query)

    def on_notification_group(self, update):
        chat_id = model._int(update.get("chat_id"))
        if not chat_id:
            return
        total = model._int(update.get("total_count"))
        added = [model._obj(n, "notification") for n in model._list(update.get("added_notifications"), 100)]
        loud = [n for n in added if n and n.get("is_silent") is not True
                and model._obj(n.get("type")).get("@type") == "notificationTypeNewMessage"]
        if not loud:
            if total == 0:
                self.notifier.withdraw(chat_id)
            return
        kind = model._obj(max(loud, key=lambda n: model._int(n.get("id"))).get("type"))
        message = self.state.message(kind.get("message"))
        chat = self.state.chats.get(chat_id)
        title = chat["title"] if chat else ""
        if total > 1:
            title = f"{title} ({total})"
        if message is None or kind.get("show_preview") is not True:
            body = "New message"
        else:
            body = model.preview_text(message["content"])
            if chat and chat["kind"] != "private" and message["senderName"]:
                body = f"{message['senderName']}: {body}"
        self.notifier.show(chat_id, title, body)

    def on_notification_action(self, chat_id, action):
        if action == "reply":
            self.summon_quick_reply(chat_id)
        else:
            self.open_chat(chat_id, False)
            self.launch_window()

    def summon_quick_reply(self, chat_id):
        """Reply opens the quick-reply overlay on that chat. The overlay lives in Omarchy's shell;
        when that is not there, the window opens on the chat with its composer focused instead."""
        def fallback():
            self.open_chat(chat_id, True)
            self.launch_window()
        self.spawn([OMARCHY_SHELL, "shell", "summon", PLUGIN_ID, json.dumps({"chatId": chat_id})], fallback)

    def open_chat(self, chat_id, reply):
        """Tell the window to open a chat, or keep the request for the window that starts next."""
        target = {"chatId": chat_id, "reply": reply}
        windows = [c for c in self.clients.values() if c.window]
        self.pending_open = None if windows else (time.monotonic(), target)
        for client in windows:
            self.send_to(client, dict({"event": "open"}, **target))

    def launch_window(self):
        """`omagram`, in its own session with no terminal: it focuses the open window or starts one."""
        self.spawn(["/usr/bin/python3", str(pathlib.Path(__file__).resolve().parent / "omagram")])

    def spawn(self, argv, fallback=None):
        """A detached helper: its own session, no terminal, no loader or Claude variables. An
        argv list, never a shell. `fallback` runs if it cannot start or does not succeed."""
        env = {k: v for k, v in os.environ.items() if not k.startswith(("LD_", "PYTHON", "CLAUDE"))}
        env["PATH"] = safe.SAFE_PATH
        try:
            pid = os.posix_spawn(argv[0], argv, env, setsid=True,
                                 file_actions=[(os.POSIX_SPAWN_OPEN, 0, os.devnull, os.O_RDWR, 0),
                                               (os.POSIX_SPAWN_DUP2, 0, 1), (os.POSIX_SPAWN_DUP2, 0, 2)])
        except OSError:
            if fallback:
                fallback()
            return
        self.children[pid] = fallback

    def reap_children(self):
        for pid, fallback in list(self.children.items()):
            try:
                done, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                done, status = pid, 0
            if not done:
                continue
            del self.children[pid]
            if fallback and not (os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0):
                fallback()

    def on_me(self, user):
        uid = model._int(user.get("id"))
        if not uid:
            return
        self.state.me_id = uid
        self.state.apply({"@type": "updateUser", "user": user})
        self.broadcast({"event": "me", "meId": uid})

    def set_auth(self, auth):
        self.auth = auth
        self.broadcast({"event": "auth", "auth": auth})

    # ---------------------------------------------------------------- sockets

    def accept(self):
        try:
            conn, _ = self.listener.accept()
        except (BlockingIOError, OSError):
            return
        try:
            creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
            _, uid, _ = struct.unpack("3i", creds)
        except OSError:
            conn.close()
            return
        if uid != os.getuid() or len(self.clients) >= CLIENTS_MAX:
            conn.close()
            return
        conn.setblocking(False)
        client = Client(conn)
        self.clients[conn.fileno()] = client
        self.sel.register(conn, selectors.EVENT_READ, client)

    def drop(self, client):
        fd = client.sock.fileno()
        if fd in self.clients:
            del self.clients[fd]
            try:
                self.sel.unregister(client.sock)
            except (KeyError, ValueError):
                pass
        for extra in [e for e, (c, _, _) in self.pending.items() if c is client]:
            del self.pending[extra]
        client.sock.close()

    def on_socket(self, client, mask):
        if mask & selectors.EVENT_WRITE:
            self.flush(client)
        if mask & selectors.EVENT_READ:
            try:
                chunk = client.sock.recv(65536)
            except BlockingIOError:
                return
            except OSError:
                self.drop(client)
                return
            if not chunk:
                self.drop(client)
                return
            client.inbox += chunk
            while True:
                newline = client.inbox.find(b"\n")
                if newline < 0:
                    break
                line = bytes(client.inbox[:newline])
                del client.inbox[:newline + 1]
                if len(line) > LINE_MAX:
                    self.drop(client)
                    return
                self.handle_line(client, line)
                if client.sock.fileno() not in self.clients:
                    return
            if len(client.inbox) > LINE_MAX:
                self.drop(client)

    def send_to(self, client, value):
        data = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8") + b"\n"
        if len(client.outbox) + len(data) > OUTBOX_MAX:
            self.drop(client)   # not reading: better a reconnect than unbounded memory
            return
        client.outbox += data
        self.flush(client)

    def flush(self, client):
        if client.sock.fileno() not in self.clients:
            return
        try:
            while client.outbox:
                sent = client.sock.send(client.outbox)
                del client.outbox[:sent]
        except BlockingIOError:
            pass
        except OSError:
            self.drop(client)
            return
        events = selectors.EVENT_READ | (selectors.EVENT_WRITE if client.outbox else 0)
        try:
            self.sel.modify(client.sock, events, client)
        except (KeyError, ValueError):
            pass

    def broadcast(self, value):
        for client in list(self.clients.values()):
            self.send_to(client, value)

    def respond(self, client, rid, result):
        self.send_to(client, {"id": rid, "ok": True, "result": result})

    def respond_error(self, client, rid, message, code=0):
        self.send_to(client, {"id": rid, "ok": False, "error": message or "failed", "code": code})

    # ---------------------------------------------------------------- requests

    def handle_line(self, client, line):
        try:
            request = safe.loads(line, **REQUEST_LIMITS)
        except (ValueError, UnicodeDecodeError, safe.UnsafeError):
            self.respond_error(client, None, "not a JSON request")
            return
        if not isinstance(request, dict):
            self.respond_error(client, None, "not a request")
            return
        rid = request.get("id")
        if isinstance(rid, bool) or not isinstance(rid, int):
            self.respond_error(client, None, "id must be an integer")
            return
        cmd = request.get("cmd")
        args = request.get("args", {})
        handler = COMMANDS.get(cmd) if isinstance(cmd, str) else None
        if handler is None or not isinstance(args, dict):
            self.respond_error(client, rid, "unknown command")
            return
        name, needs_ready = handler
        if needs_ready and self.auth.get("state") != "ready":
            self.respond_error(client, rid, "not signed in")
            return
        try:
            getattr(self, name)(client, rid, args)
        except BadRequest as e:
            self.respond_error(client, rid, str(e))

    def cmd_hello(self, client, rid, args):
        target = None
        if args.get("window") is True:
            client.window = True
            if self.pending_open and time.monotonic() - self.pending_open[0] < OPEN_TTL:
                target = self.pending_open[1]
            self.pending_open = None
        answer = {"version": VERSION, "auth": self.auth, "meId": self.state.me_id,
                  "chats": self.state.chat_list("main", 100), "open": target,
                  "folders": self.state.folders, "mainPosition": self.state.main_position}
        if client.window:
            answer["allChats"] = self.state.all_chats()   # the window's tabs need every list
        self.respond(client, rid, answer)

    def found_messages(self, event):
        found = (self.state.message(m) for m in model._list(event.get("messages"), 100))
        return [m for m in found if m]

    def cmd_chats_search(self, client, rid, args):
        query = arg_str(args, "query", QUERY_MAX)
        limit = arg_int(args, "limit", 1, 100, 30)
        server = args.get("server") is True

        def found(event):
            ids = [model._int(i) for i in model._list(event.get("chat_ids"), 100)]
            views = (self.state.chat_view(i) for i in ids if i)
            return {"query": query, "server": server, "chats": [v for v in views if v]}
        self.td_send({"@type": "searchChatsOnServer" if server else "searchChats", "query": query,
                      "type_filter": None, "limit": limit}, client, rid, found)

    def cmd_messages_search(self, client, rid, args):
        query = arg_str(args, "query", QUERY_MAX)
        limit = arg_int(args, "limit", 1, 100, 30)
        if args.get("chatId") is not None:
            chat_id = arg_int(args, "chatId")
            request = {"@type": "searchChatMessages", "chat_id": chat_id, "topic_id": None, "query": query,
                       "sender_id": None, "from_message_id": arg_int(args, "fromMessageId", 0, None, 0),
                       "offset": 0, "limit": limit, "filter": None}

            def found(event):
                return {"query": query, "chatId": chat_id, "messages": self.found_messages(event),
                        "total": model._int(event.get("total_count")),
                        "nextFromMessageId": model._int(event.get("next_from_message_id"))}
        else:
            offset = args.get("offset", "")
            if not isinstance(offset, str) or len(offset) > OFFSET_MAX:
                raise BadRequest("offset is the text a previous search returned")
            request = {"@type": "searchMessages", "chat_list": None, "query": query, "offset": offset,
                       "limit": limit, "filter": None, "chat_type_filter": None, "min_date": 0, "max_date": 0}

            def found(event):
                return {"query": query, "chatId": 0, "messages": self.found_messages(event),
                        "total": model._int(event.get("total_count")),
                        "nextOffset": model._str(event.get("next_offset"), OFFSET_MAX)}
        self.td_send(request, client, rid, found)

    def cmd_chat_pin(self, client, rid, args):
        _, chat_list = arg_list(args)
        pinned = args.get("pinned")
        if not isinstance(pinned, bool):
            raise BadRequest("pinned must be true or false")
        self.td_send({"@type": "toggleChatIsPinned", "chat_list": chat_list,
                      "chat_id": arg_int(args, "chatId"), "is_pinned": pinned}, client, rid)

    def cmd_chat_archive(self, client, rid, args):
        archived = args.get("archived")
        if not isinstance(archived, bool):
            raise BadRequest("archived must be true or false")
        target = {"@type": "chatListArchive" if archived else "chatListMain"}

        def moved(event):
            # TDLib reports a chat's place in a list only once that list is loaded: until the
            # archive is, a chat moved there has no position anywhere and would vanish.
            self.td_send({"@type": "loadChats", "chat_list": target, "limit": 100})
            return {}
        self.td_send({"@type": "addChatToList", "chat_id": arg_int(args, "chatId"), "chat_list": target},
                     client, rid, moved)

    def cmd_ui_focus(self, client, rid, args):
        self.notifier.focus(arg_int(args, "chatId", None, None, 0))
        self.respond(client, rid, {})

    def cmd_ui_open(self, client, rid, args):
        self.open_chat(arg_int(args, "chatId"), args.get("reply") is True)
        self.respond(client, rid, {})

    def cmd_credentials_set(self, client, rid, args):
        api_id, api_hash = args.get("apiId"), args.get("apiHash")
        if isinstance(api_id, int) and not isinstance(api_id, bool):
            api_id = str(api_id)
        if not self.keyring.valid_credentials(api_id, api_hash):
            raise BadRequest("the API id is a number and the API hash is 32 hexadecimal characters")
        if not self.keyring.save_credentials(api_id, api_hash):
            self.respond_error(client, rid, "the keyring did not accept the credentials")
            return
        self.respond(client, rid, {})
        if self.auth.get("state") in ("needCredentials", "error"):
            self.set_auth({"state": "starting"})
            self.send_parameters()

    def cmd_auth_phone(self, client, rid, args):
        phone = arg_str(args, "phone", 32, 5)
        if not PHONE.fullmatch(phone):
            raise BadRequest("that does not look like a phone number")
        self.td_send({"@type": "setAuthenticationPhoneNumber", "phone_number": re.sub(r"[ ()-]", "", phone),
                      "settings": None}, client, rid)

    def cmd_auth_code(self, client, rid, args):
        code = arg_str(args, "code", 10, 3)
        if not CODE.fullmatch(code):
            raise BadRequest("the code is digits only")
        self.td_send({"@type": "checkAuthenticationCode", "code": code}, client, rid)

    def cmd_auth_password(self, client, rid, args):
        self.td_send({"@type": "checkAuthenticationPassword", "password": arg_str(args, "password", 512)}, client, rid)

    def cmd_auth_qr(self, client, rid, args):
        self.td_send({"@type": "requestQrCodeAuthentication", "other_user_ids": []}, client, rid)

    def cmd_auth_logout(self, client, rid, args):
        self.td_send({"@type": "logOut"}, client, rid)

    def cmd_chats_load(self, client, rid, args):
        limit = arg_int(args, "limit", 1, 500, 100)
        key, chat_list = arg_list(args)

        def done(event):
            return {"list": key, "done": False}
        # TDLib answers 404 once the whole list is loaded.
        self.td_send({"@type": "loadChats", "chat_list": chat_list, "limit": limit}, client, rid, done)

    def cmd_chat_list(self, client, rid, args):
        key, _ = arg_list(args)
        self.respond(client, rid, {"chats": self.state.chat_list(key, arg_int(args, "limit", 1, 500, 200))})

    def cmd_chat_history(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        query = {"@type": "getChatHistory", "chat_id": chat_id,
                 "from_message_id": arg_int(args, "fromMessageId", 0, None, 0),
                 "offset": arg_int(args, "offset", -99, 0, 0),
                 "limit": arg_int(args, "limit", 1, 100, 50),
                 "only_local": False}

        def messages(event):
            found = [self.state.message(m) for m in model._list(event.get("messages"), 100)]
            return {"chatId": chat_id, "messages": [m for m in found if m]}
        self.td_send(query, client, rid, messages)

    def cmd_chat_open(self, client, rid, args):
        self.td_send({"@type": "openChat", "chat_id": arg_int(args, "chatId")}, client, rid)

    def cmd_chat_close(self, client, rid, args):
        self.td_send({"@type": "closeChat", "chat_id": arg_int(args, "chatId")}, client, rid)

    def cmd_chat_read(self, client, rid, args):
        self.td_send({"@type": "viewMessages", "chat_id": arg_int(args, "chatId"),
                      "message_ids": arg_ids(args, "messageIds"),
                      "source": {"@type": "messageSourceChatHistory"}, "force_read": True}, client, rid)

    def reply_to(self, args):
        if args.get("replyToMessageId") is None:
            return None
        return {"@type": "inputMessageReplyToMessage", "message_id": arg_int(args, "replyToMessageId", 1),
                "quote": None, "checklist_task_id": 0, "poll_option_id": ""}

    def send_content(self, client, rid, chat_id, content, args):
        self.td_send({"@type": "sendMessage", "chat_id": chat_id, "topic_id": None, "reply_to": self.reply_to(args),
                      "options": None, "reply_markup": None, "input_message_content": content},
                     client, rid, self.state.message)

    def cmd_message_send(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        text = arg_str(args, "text", TEXT_MAX)
        self.send_content(client, rid, chat_id, {"@type": "inputMessageText",
                                                 "text": {"@type": "formattedText", "text": text, "entities": []},
                                                 "link_preview_options": None, "clear_draft": True}, args)

    def cmd_message_send_file(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        path, size = local_upload(args.get("path"))
        caption = args.get("caption", "")
        if not isinstance(caption, str) or len(caption) > CAPTION_MAX:
            raise BadRequest(f"a caption is text of at most {CAPTION_MAX} characters")
        as_photo = args.get("asPhoto", True) is True and path.lower().endswith(PHOTO_EXTENSIONS) and size <= PHOTO_MAX
        text = {"@type": "formattedText", "text": caption, "entities": []}
        upload = {"@type": "inputFileLocal", "path": path}
        if as_photo:
            content = {"@type": "inputMessagePhoto", "caption": text, "show_caption_above_media": False,
                       "self_destruct_type": None, "has_spoiler": False,
                       "photo": {"@type": "inputPhoto", "photo": upload, "thumbnail": None, "video": None,
                                 "added_sticker_file_ids": [], "width": 0, "height": 0}}
        else:
            content = {"@type": "inputMessageDocument", "caption": text,
                       "document": {"@type": "inputDocument", "document": upload, "thumbnail": None,
                                    "disable_content_type_detection": False}}
        self.send_content(client, rid, chat_id, content, args)

    def cmd_message_send_sticker(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        emoji = args.get("emoji", "")
        if not isinstance(emoji, str) or len(emoji) > 16:
            raise BadRequest("emoji is a short text")
        content = {"@type": "inputMessageSticker", "emoji": emoji,
                   "sticker": {"@type": "inputSticker", "thumbnail": None,
                               "sticker": {"@type": "inputFileId", "id": arg_int(args, "fileId", 1, FILE_ID_MAX)},
                               "width": arg_int(args, "width", 0, 10000, 0), "height": arg_int(args, "height", 0, 10000, 0)}}
        self.send_content(client, rid, chat_id, content, args)

    def sticker_views(self, stickers):
        views = []
        for raw in model._list(stickers, STICKERS_MAX):
            view = model.media_for("sticker", {"sticker": raw}, self.state.files_root)
            if view is not None:
                views.append(view)
        return views

    def cmd_stickers_recent(self, client, rid, args):
        self.td_send({"@type": "getRecentStickers", "is_attached": False}, client, rid,
                     lambda e: {"stickers": self.sticker_views(e.get("stickers"))})

    def cmd_stickers_sets(self, client, rid, args):
        def sets(event):
            out = []
            for raw in model._list(event.get("sets"), 200):
                info = model._obj(raw, "stickerSetInfo")
                if not info:
                    continue
                covers = self.sticker_views(info.get("covers"))
                # Set ids are int64: sent as text so JavaScript does not round them.
                out.append({"id": str(model._int(info.get("id"))), "title": model._str(info.get("title"), 128),
                            "size": max(0, model._int(info.get("size"))), "cover": covers[0] if covers else None})
            return {"sets": out}
        self.td_send({"@type": "getInstalledStickerSets", "sticker_type": {"@type": "stickerTypeRegular"}}, client, rid, sets)

    def cmd_stickers_set(self, client, rid, args):
        set_id = args.get("setId")
        if not isinstance(set_id, str) or not SET_ID.fullmatch(set_id):
            raise BadRequest("setId is a sticker set id, as text")

        def stickers(event):
            return {"id": set_id, "title": model._str(event.get("title"), 128), "stickers": self.sticker_views(event.get("stickers"))}
        self.td_send({"@type": "getStickerSet", "set_id": int(set_id)}, client, rid, stickers)

    def cmd_message_edit(self, client, rid, args):
        self.td_send({"@type": "editMessageText", "chat_id": arg_int(args, "chatId"),
                      "message_id": arg_int(args, "messageId", 1), "reply_markup": None,
                      "input_message_content": {"@type": "inputMessageText",
                                                "text": {"@type": "formattedText", "text": arg_str(args, "text", TEXT_MAX),
                                                         "entities": []},
                                                "link_preview_options": None, "clear_draft": False}},
                     client, rid, self.state.message)

    def cmd_message_delete(self, client, rid, args):
        revoke = args.get("revoke", True)
        if not isinstance(revoke, bool):
            raise BadRequest("revoke must be true or false")
        self.td_send({"@type": "deleteMessages", "chat_id": arg_int(args, "chatId"),
                      "message_ids": arg_ids(args, "messageIds"), "revoke": revoke}, client, rid)

    def cmd_file_download(self, client, rid, args):
        query = {"@type": "downloadFile", "file_id": arg_int(args, "fileId", 1, FILE_ID_MAX),
                 "priority": arg_int(args, "priority", 1, 32, 16), "offset": 0, "limit": 0, "synchronous": False}
        self.td_send(query, client, rid, lambda f: model.file_view(f, self.state.files_root) or {})

    def cmd_sticker_lottie(self, client, rid, args):
        def convert(f):
            view = model.file_view(f, self.state.files_root)
            return {"path": lottie_json(view["path"]) if view and view["path"] else ""}
        self.td_send({"@type": "getFile", "file_id": arg_int(args, "fileId", 1, FILE_ID_MAX)}, client, rid, convert)

    def drain_wake(self):
        try:
            while os.read(self.wake_r, 4096):
                pass
        except (BlockingIOError, OSError):
            pass


