    # ---------------------------------------------------------------- voice and video messages

    def reply_args(self, args):
        picked = {k: args[k] for k in ("replyToMessageId", "topicId", "threadId", "silent", "sendAt") if k in args}
        self.reply_to(picked)   # checked now, before any recording is used up
        self.topic_of(picked)
        self.send_options(picked)
        return picked

    def cmd_voice_start(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        if self.recording is not None:
            raise BadRequest("a voice message is already being recorded")
        try:
            media.clean_stale()
            path = media.new_sent_path("voice", ".ogg")
            argv = media.voice_argv(path)
        except (safe.UnsafeError, OSError) as e:
            raise BadRequest(f"cannot record: {e}")
        proc = self.start_helper(argv)
        if proc is None:
            raise BadRequest("cannot start the recorder")
        started = int(time.time() * 1000)
        self.recording = {"proc": proc, "path": path, "chatId": chat_id, "started": started}
        self.respond(client, rid, {"startedAt": started})
        self.broadcast({"event": "recording", "state": "voice", "chatId": chat_id, "startedAt": started})

    def cmd_voice_stop(self, client, rid, args):
        rec = self.recording
        if rec is None:
            raise BadRequest("nothing is being recorded")
        send = args.get("send") is True
        reply = self.reply_args(args) if send else {}
        self.recording = None
        self.broadcast({"event": "recording", "state": "idle"})
        proc, path, chat_id = rec["proc"], rec["path"], rec["chatId"]
        try:
            proc.send_signal(signal.SIGINT)   # ffmpeg finishes the file on its first interrupt
        except OSError:
            pass

        def work():
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
            if not send:
                media.remove(path)
                return None
            return media.prepare_voice(path)

        def done(result, error):
            if not send:
                self.respond(client, rid, {})
                return
            if error is not None or not result or result[0] < 1:
                media.remove(path)
                self.respond_error(client, rid, "that voice message was too short or could not be read")
                return
            duration, waveform = result
            self.send_content(client, rid, chat_id, {
                "@type": "inputMessageVoiceNote",
                "voice_note": {"@type": "inputVoiceNote", "voice_note": {"@type": "inputFileLocal", "path": str(path)},
                               "duration": duration, "waveform": waveform},
                "caption": None, "self_destruct_type": None}, reply)
        self.background(work, done)

    def cmd_videonote_send(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        try:
            source = media.recorded_file(args.get("path"))
        except (safe.UnsafeError, OSError):
            raise BadRequest("that is not a recording of Omagram's")
        reply = self.reply_args(args)
        if self.jobs >= JOBS_MAX:
            raise BadRequest("still preparing an earlier message")
        target = media.new_sent_path("note", ".mp4")

        def work():
            try:
                return media.prepare_video_note(source, target)
            finally:
                media.remove(source)

        def done(duration, error):
            if error is not None:
                media.remove(target)
                self.respond_error(client, rid, "the video message could not be prepared")
                return
            self.send_content(client, rid, chat_id, {
                "@type": "inputMessageVideoNote",
                "video_note": {"@type": "inputVideoNote", "video_note": {"@type": "inputFileLocal", "path": str(target)},
                               "thumbnail": None, "duration": max(1, min(media.NOTE_MAX_SECONDS, int(duration))),
                               "length": media.NOTE_SIZE},
                "self_destruct_type": None}, reply)
        self.background(work, done)

    def cmd_videonote_discard(self, client, rid, args):
        try:
            media.remove(media.recorded_file(args.get("path")))
        except (safe.UnsafeError, OSError):
            raise BadRequest("that is not a recording of Omagram's")
        self.respond(client, rid, {})

    # ---------------------------------------------------------------- settings

    def apply_globals(self):
        """Register the global shortcuts you chose with Hyprland (and remove old ones of ours)."""
        desired = self.prefs["globalShortcuts"]
        if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            self.global_status = {a: ("unavailable" if a in desired else "off") for a in prefs.GLOBALS}
            return
        try:
            self.global_status = prefs.apply(desired)
        except (safe.UnsafeError, OSError, ValueError):
            self.global_status = {a: ("failed" if a in desired else "off") for a in prefs.GLOBALS}

    def settings_view(self):
        return {"settings": self.prefs, "globalStatus": self.global_status}

    def cmd_settings_set(self, client, rid, args):
        settings = args.get("settings")
        if isinstance(settings, dict):   # the shortcuts page leaves the speed and the downloads as they are
            settings = dict({k: self.prefs[k] for k in ("playbackRate", "autoDownload") if k in self.prefs}, **settings)
        try:
            new = prefs.check(settings)
        except ValueError as e:
            raise BadRequest(str(e))
        try:
            prefs.save(new)
        except (safe.UnsafeError, OSError):
            raise BadRequest("the settings could not be saved")
        changed = new["globalShortcuts"] != self.prefs["globalShortcuts"]
        self.prefs = new
        if changed:
            self.apply_globals()
        self.respond(client, rid, self.settings_view())
        self.broadcast(dict({"event": "settings"}, **self.settings_view()))

    def cmd_settings_playback(self, client, rid, args):
        """How fast voice and video messages play (1, 1.5 or 2), kept for the next time."""
        rate = args.get("rate")
        if isinstance(rate, bool) or rate not in prefs.PLAYBACK_RATES:
            raise BadRequest("the playback rate is 1, 1.5 or 2")
        new = dict(self.prefs, playbackRate=rate)
        try:
            prefs.save(new)
        except (safe.UnsafeError, OSError):
            raise BadRequest("the settings could not be saved")
        self.prefs = new
        self.respond(client, rid, self.settings_view())
        self.broadcast(dict({"event": "settings"}, **self.settings_view()))

    def cmd_settings_auto_download(self, client, rid, args):
        """What downloads by itself as it comes on screen: photos, and GIFs with round video messages (yes
        or no), videos and files (up to 10 or 50 MB, or never)."""
        try:
            new = prefs.check(dict(self.prefs, autoDownload=args.get("rules")))
        except ValueError as e:
            raise BadRequest(str(e))
        try:
            prefs.save(new)
        except (safe.UnsafeError, OSError):
            raise BadRequest("the settings could not be saved")
        self.prefs = new
        self.respond(client, rid, self.settings_view())
        self.broadcast(dict({"event": "settings"}, **self.settings_view()))

    def cmd_shortcuts_apply(self, client, rid, args):
        """After Hyprland reloads its config (which drops runtime bindings), register them again."""
        self.apply_globals()
        self.respond(client, rid, self.settings_view())
        self.broadcast(dict({"event": "settings"}, **self.settings_view()))

    def cmd_ui_focus(self, client, rid, args):
        chat_id = arg_int(args, "chatId", None, None, 0)
        self.focus_client = client if chat_id else None
        self.notifier.focus(chat_id)
        self.respond(client, rid, {})

    def cmd_ui_open(self, client, rid, args):
        self.open_chat(arg_int(args, "chatId"), args.get("reply") is True)
        self.respond(client, rid, {})

    def cmd_credentials_set(self, client, rid, args):
        api_id, api_hash = args.get("apiId"), args.get("apiHash")
        if isinstance(api_id, int) and not isinstance(api_id, bool):
            api_id = str(api_id)
        if not self.keyring.valid_credentials(api_id, api_hash):
            raise BadRequest("the API id is a number and the API hash is 32 hexadecimal characters")
        if not self.keyring.save_credentials(api_id, api_hash):
            self.respond_error(client, rid, "the keyring did not accept the credentials")
            return
        self.respond(client, rid, {})
        if self.auth.get("state") in ("needCredentials", "error"):
            self.set_auth({"state": "starting"})
            self.send_parameters()

    def cmd_auth_phone(self, client, rid, args):
        phone = arg_str(args, "phone", 32, 5)
        if not PHONE.fullmatch(phone):
            raise BadRequest("that does not look like a phone number")
        self.td_send({"@type": "setAuthenticationPhoneNumber", "phone_number": re.sub(r"[ ()-]", "", phone),
                      "settings": None}, client, rid)

    def cmd_auth_code(self, client, rid, args):
        code = arg_str(args, "code", 10, 3)
        if not CODE.fullmatch(code):
            raise BadRequest("the code is digits only")
        self.td_send({"@type": "checkAuthenticationCode", "code": code}, client, rid)

    def cmd_auth_password(self, client, rid, args):
        self.td_send({"@type": "checkAuthenticationPassword", "password": arg_str(args, "password", 512)}, client, rid)

    def cmd_auth_qr(self, client, rid, args):
        self.td_send({"@type": "requestQrCodeAuthentication", "other_user_ids": []}, client, rid)

    def cmd_auth_logout(self, client, rid, args):
        self.td_send({"@type": "logOut"}, client, rid)

    def cmd_chats_load(self, client, rid, args):
        limit = arg_int(args, "limit", 1, 500, 100)
        key, chat_list = arg_list(args)

        def done(event):
            return {"list": key, "done": False}
        # TDLib answers 404 once the whole list is loaded.
        self.td_send({"@type": "loadChats", "chat_list": chat_list, "limit": limit}, client, rid, done)

    def cmd_chat_list(self, client, rid, args):
        key, _ = arg_list(args)
        self.respond(client, rid, {"chats": self.state.chat_list(key, arg_int(args, "limit", 1, 500, 200))})

    def cmd_chat_history(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        query = {"@type": "getChatHistory", "chat_id": chat_id,
                 "from_message_id": arg_int(args, "fromMessageId", 0, None, 0),
                 "offset": arg_int(args, "offset", -99, 0, 0),
                 "limit": arg_int(args, "limit", 1, 100, 50),
                 "only_local": False}

        def messages(event):
            found = [self.state.message(m) for m in model._list(event.get("messages"), 100)]
            return {"chatId": chat_id, "messages": [m for m in found if m]}
        self.td_send(query, client, rid, messages)

    def cmd_chat_open(self, client, rid, args):
        """Opens a chat to read, and answers with the chat: one found by name or reached by a link may
        be in none of your lists, so the window has not heard of it."""
        chat_id = arg_int(args, "chatId")
        self.td_send({"@type": "openChat", "chat_id": chat_id}, client, rid,
                     lambda _event: {"chat": self.state.chat_view(chat_id)})

    def cmd_chat_close(self, client, rid, args):
        self.td_send({"@type": "closeChat", "chat_id": arg_int(args, "chatId")}, client, rid)

    def cmd_chat_read(self, client, rid, args):
        topic = self.topic_of(args)
        source = ("messageSourceChatHistory" if topic is None
                  else "messageSourceForumTopicHistory" if topic["@type"] == "messageTopicForum"
                  else "messageSourceMessageThreadHistory")
        self.td_send({"@type": "viewMessages", "chat_id": arg_int(args, "chatId"),
                      "message_ids": arg_ids(args, "messageIds"), "source": {"@type": source},
                      "force_read": True}, client, rid)

    def reply_to(self, args):
        if args.get("replyToMessageId") is None:
            return None
        return {"@type": "inputMessageReplyToMessage", "message_id": arg_int(args, "replyToMessageId", 1),
                "quote": None, "checklist_task_id": 0, "poll_option_id": ""}

    def topic_of(self, args):
        """Where in the chat: a forum topic (topicId), the comments or replies under a message
        (threadId, the thread's id in the chat it lives in), or None for the chat itself."""
        if args.get("threadId") is not None:
            if args.get("topicId") is not None:
                raise BadRequest("a topic or a thread, not both")
            return {"@type": "messageTopicThread", "message_thread_id": arg_int(args, "threadId", 1)}
        if args.get("topicId") is None:
            return None
        return {"@type": "messageTopicForum", "forum_topic_id": arg_int(args, "topicId", 1, INT32_MAX)}

    def send_options(self, args):
        """How a message goes out: silently, and at a date (sendAt, in seconds) or once the other
        person is online (sendAt -1). None when neither is asked for."""
        silent = args.get("silent", False)
        if not isinstance(silent, bool):
            raise BadRequest("silent is true or false")
        send_at = arg_int(args, "sendAt", -1, None, 0)
        if send_at > 0 and not time.time() + 10 <= send_at <= time.time() + SCHEDULE_MAX:
            raise BadRequest("a message can be scheduled from now to a year ahead")
        if not silent and not send_at:
            return None
        scheduling = None
        if send_at > 0:
            scheduling = {"@type": "messageSchedulingStateSendAtDate", "send_date": send_at, "repeat_period": 0}
        elif send_at == -1:
            scheduling = {"@type": "messageSchedulingStateSendWhenOnline"}
        return {"@type": "messageSendOptions", "suggested_post_info": None, "disable_notification": silent,
                "from_background": False, "protect_content": False, "allow_paid_broadcast": False, "paid_message_star_count": 0,
                "update_order_of_installed_sticker_sets": False, "scheduling_state": scheduling, "effect_id": 0,
                "sending_id": 0, "only_preview": False}

    def typed_text(self, text, limit, what):
        """Text as typed, with its Telegram Markdown (**bold**, __italic__, ~~strikethrough~~,
        ||spoiler||, `code`, ```pre```, [text](address)) read into formatting by TDLib. Text TDLib
        cannot read goes as it was typed."""
        plain = {"@type": "formattedText", "text": text, "entities": []}
        execute = getattr(self.td, "execute", None)
        parsed = None
        if text.strip() and execute is not None:
            try:
                parsed = execute({"@type": "parseMarkdown", "text": plain})
            except (OSError, ValueError):
                parsed = None
        if (not isinstance(parsed, dict) or parsed.get("@type") != "formattedText"
                or not isinstance(parsed.get("text"), str) or not isinstance(parsed.get("entities"), list)):
            parsed = plain
        if len(parsed["text"]) > limit:
            raise BadRequest(f"{what} can be at most {limit} characters")
        return dict(parsed, entities=mention_links(parsed["entities"]))

    def send_content(self, client, rid, chat_id, content, args):
        self.td_send({"@type": "sendMessage", "chat_id": chat_id, "topic_id": self.topic_of(args), "reply_to": self.reply_to(args),
                      "options": self.send_options(args), "reply_markup": None, "input_message_content": content},
                     client, rid, self.state.message)

    def cmd_message_send(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        text = self.typed_text(arg_str(args, "text", MARKDOWN_TEXT_MAX), TEXT_MAX, "a message")
        self.send_content(client, rid, chat_id, {"@type": "inputMessageText", "text": text,
                                                 "link_preview_options": None, "clear_draft": True}, args)

    def cmd_message_send_file(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        path, size = local_upload(args.get("path"))
        caption = args.get("caption", "")
        if not isinstance(caption, str) or len(caption) > MARKDOWN_CAPTION_MAX:
            raise BadRequest(f"a caption is text of at most {CAPTION_MAX} characters")
        kind = file_kind(path, size, args.get("asPhoto", True) is True)
        text = self.typed_text(caption, CAPTION_MAX, "a caption")
        reply = self.reply_args(args)
        if kind not in ("video", "audio"):
            self.send_content(client, rid, chat_id, file_content(path, kind, text, (0, 0, 0)), reply)
            return
        # A video's length and size, and music's length, are read first, as Telegram's player needs them.
        self.background(lambda: media.probe_media(path),
                        lambda probed, error: self.send_content(
                            client, rid, chat_id, file_content(path, kind, text, probed if error is None else (0, 0, 0)), reply))

    def cmd_message_send_files(self, client, rid, args):
        """Up to ten files at once, as Telegram's apps send them: photos and videos in albums, files
        and music in albums of their own, the caption on the first."""
        chat_id = arg_int(args, "chatId")
        paths = args.get("paths")
        if not isinstance(paths, list) or not 1 <= len(paths) <= FILES_MAX:
            raise BadRequest(f"paths is a list of 1 to {FILES_MAX} files")
        as_media = args.get("asMedia", True)
        if not isinstance(as_media, bool):
            raise BadRequest("asMedia is true or false")
        caption = args.get("caption", "")
        if not isinstance(caption, str) or len(caption) > MARKDOWN_CAPTION_MAX:
            raise BadRequest(f"a caption is text of at most {CAPTION_MAX} characters")
        text = self.typed_text(caption, CAPTION_MAX, "a caption")
        files = []
        for given in paths:
            path, size = local_upload(given)
            files.append((path, file_kind(path, size, as_media)))
        reply = self.reply_args(args)

        def send(probed):
            contents = [file_content(path, kind, text if i == 0 else None, probed[i]) for i, (path, kind) in enumerate(files)]
            self.send_groups(client, rid, chat_id, album_groups([kind for _, kind in files]), contents, reply)

        if not any(kind in ("video", "audio") for _, kind in files):
            send([(0, 0, 0)] * len(files))
            return
        self.background(lambda: [media.probe_media(path) if kind in ("video", "audio") else (0, 0, 0) for path, kind in files],
                        lambda probed, error: send(probed if error is None else [(0, 0, 0)] * len(files)))

    def send_groups(self, client, rid, chat_id, groups, contents, reply):
        """Each group as an album, or as a message when it holds one file; answered once all are sent."""
        state = {"left": len(groups), "error": None}

        def finished(error=None):
            if error and state["error"] is None:
                state["error"] = error
            state["left"] -= 1
            if state["left"] > 0:
                return
            if state["error"]:
                self.respond_error(client, rid, state["error"])
            else:
                self.respond(client, rid, {"groups": len(groups)})

        def refused(event=None):
            finished(model._str(model._obj(event).get("message"), 256) or "Telegram did not take the files")

        for n, group in enumerate(groups):
            base = {"chat_id": chat_id, "topic_id": self.topic_of(reply), "options": self.send_options(reply),
                    "reply_to": self.reply_to(reply) if n == 0 else None}
            if len(group) == 1:
                query = dict(base, **{"@type": "sendMessage", "reply_markup": None, "input_message_content": contents[group[0]]})
            else:
                query = dict(base, **{"@type": "sendMessageAlbum", "input_message_contents": [contents[i] for i in group]})
            self.td_send(query, transform=lambda _event: finished(), failed=refused)

    def cmd_message_send_sticker(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        emoji = args.get("emoji", "")
        if not isinstance(emoji, str) or len(emoji) > 16:
            raise BadRequest("emoji is a short text")
        content = {"@type": "inputMessageSticker", "emoji": emoji,
                   "sticker": {"@type": "inputSticker", "thumbnail": None,
                               "sticker": {"@type": "inputFileId", "id": arg_int(args, "fileId", 1, FILE_ID_MAX)},
                               "width": arg_int(args, "width", 0, 10000, 0), "height": arg_int(args, "height", 0, 10000, 0)}}
        self.send_content(client, rid, chat_id, content, args)

    def cmd_message_send_dice(self, client, rid, args):
        """Dice, darts, a ball, bowling or a slot machine: the server decides what they come up with."""
        emoji = args.get("emoji")
        if emoji not in DICE_EMOJI:
            raise BadRequest("dice are one of " + " ".join(DICE_EMOJI))
        self.send_content(client, rid, arg_int(args, "chatId"), {"@type": "inputMessageDice", "emoji": emoji, "clear_draft": False}, args)

    def cmd_message_send_poll(self, client, rid, args):
        """A poll: a question and 2-12 answers, anonymous or not, one answer or several. A quiz has one
        right answer (its index in `options`) and may explain it."""
        question = arg_str(args, "question", 2 * POLL_QUESTION_MAX).strip()
        if not 1 <= len(question) <= POLL_QUESTION_MAX:
            raise BadRequest(f"a poll's question is 1-{POLL_QUESTION_MAX} characters")
        options = args.get("options")
        if (not isinstance(options, list) or not 2 <= len(options) <= POLL_ANSWERS_MAX
                or any(not isinstance(o, str) or not 1 <= len(o.strip()) <= POLL_ANSWER_MAX for o in options)):
            raise BadRequest(f"a poll has 2-{POLL_ANSWERS_MAX} answers of 1-{POLL_ANSWER_MAX} characters")
        answers = [o.strip() for o in options]
        if len({a.lower() for a in answers}) != len(answers):
            raise BadRequest("two answers are the same")
        flags = {}
        for key, default in (("anonymous", True), ("multiple", False), ("quiz", False)):
            flags[key] = args.get(key, default)
            if not isinstance(flags[key], bool):
                raise BadRequest(f"{key} is true or false")
        if flags["quiz"]:
            if flags["multiple"]:
                raise BadRequest("a quiz has one right answer")
            explanation = arg_str(args, "explanation", POLL_EXPLANATION_MAX, 0).strip() if args.get("explanation") is not None else ""
            kind = {"@type": "inputPollTypeQuiz", "correct_option_ids": [arg_int(args, "correct", 0, len(answers) - 1)],
                    "explanation": {"@type": "formattedText", "text": explanation, "entities": []}, "explanation_media": None}
        else:
            kind = {"@type": "inputPollTypeRegular", "allow_adding_options": False}
        content = {"@type": "inputMessagePoll", "question": {"@type": "formattedText", "text": question, "entities": []},
                   "options": [{"@type": "inputPollOption", "text": {"@type": "formattedText", "text": a, "entities": []}, "media": None}
                               for a in answers],
                   "description": None, "media": None, "is_anonymous": flags["anonymous"], "allows_multiple_answers": flags["multiple"],
                   "allows_revoting": not flags["quiz"], "members_only": False, "country_codes": [], "shuffle_options": False,
                   "hide_results_until_closes": False, "type": kind, "open_period": 0, "close_date": 0, "is_closed": False}
        self.send_content(client, rid, arg_int(args, "chatId"), content, args)

    def cmd_message_send_contact(self, client, rid, args):
        """A person's contact card: their name, and their number when Telegram shows it to you."""
        user_id = arg_int(args, "userId", 1)
        user = self.state.users.get(user_id)
        if user is None or user["bot"]:
            raise BadRequest("a contact card is for a person Omagram knows")
        first, _, last = user["name"].partition(" ")
        self.send_content(client, rid, arg_int(args, "chatId"), {"@type": "inputMessageContact", "contact": {
            "@type": "contact", "phone_number": user.get("phone", ""), "first_name": first, "last_name": last, "vcard": "",
            "user_id": user_id}}, args)

    def cmd_message_send_location(self, client, rid, args):
        latitude, longitude = args.get("latitude"), args.get("longitude")
        if (any(isinstance(v, bool) or not isinstance(v, (int, float)) for v in (latitude, longitude))
                or not (-90 <= latitude <= 90 and -180 <= longitude <= 180)):
            raise BadRequest("a location is a latitude from -90 to 90 and a longitude from -180 to 180")
        self.send_content(client, rid, arg_int(args, "chatId"), {"@type": "inputMessageLocation", "location": {
            "@type": "location", "latitude": float(latitude), "longitude": float(longitude), "horizontal_accuracy": 0}}, args)

    def sticker_views(self, stickers):
        views = []
        for raw in model._list(stickers, STICKERS_MAX):
            view = model.media_for("sticker", {"sticker": raw}, self.state.files_root)
            if view is not None:
                views.append(view)
        return views

    def cmd_stickers_recent(self, client, rid, args):
        self.td_send({"@type": "getRecentStickers", "is_attached": False}, client, rid,
                     lambda e: {"stickers": self.sticker_views(e.get("stickers"))})

    def cmd_stickers_sets(self, client, rid, args):
        def sets(event):
            out = []
            for raw in model._list(event.get("sets"), 200):
                info = model._obj(raw, "stickerSetInfo")
                if not info:
                    continue
                covers = self.sticker_views(info.get("covers"))
                # Set ids are int64: sent as text so JavaScript does not round them.
                out.append({"id": str(model._int(info.get("id"))), "title": model._str(info.get("title"), 128),
                            "size": max(0, model._int(info.get("size"))), "cover": covers[0] if covers else None})
            return {"sets": out}
        self.td_send({"@type": "getInstalledStickerSets", "sticker_type": {"@type": "stickerTypeRegular"}}, client, rid, sets)

    def cmd_stickers_set(self, client, rid, args):
        set_id = args.get("setId")
        if not isinstance(set_id, str) or not SET_ID.fullmatch(set_id):
            raise BadRequest("setId is a sticker set id, as text")

        def stickers(event):
            return {"id": set_id, "title": model._str(event.get("title"), 128), "stickers": self.sticker_views(event.get("stickers"))}
        self.td_send({"@type": "getStickerSet", "set_id": int(set_id)}, client, rid, stickers)

    def cmd_message_edit(self, client, rid, args):
        chat_id, message_id = arg_int(args, "chatId"), arg_int(args, "messageId", 1)
        if args.get("caption") is True:   # the caption of a photo, video, file...; it may be emptied
            query = {"@type": "editMessageCaption", "chat_id": chat_id, "message_id": message_id, "reply_markup": None,
                     "caption": self.typed_text(arg_str(args, "text", MARKDOWN_CAPTION_MAX, 0), CAPTION_MAX, "a caption"),
                     "show_caption_above_media": False}
        else:
            text = self.typed_text(arg_str(args, "text", MARKDOWN_TEXT_MAX), TEXT_MAX, "a message")
            query = {"@type": "editMessageText", "chat_id": chat_id, "message_id": message_id, "reply_markup": None,
                     "input_message_content": {"@type": "inputMessageText", "text": text,
                                               "link_preview_options": None, "clear_draft": False}}
        self.td_send(query, client, rid, self.state.message)

    def cmd_message_markdown(self, client, rid, args):
        """A message's text or caption with its formatting written as Telegram Markdown, to edit it as
        it would be typed. Formatting Markdown cannot write (underline, mentions) is left out."""
        def markdown(message):
            content = model._obj(message.get("content"))
            value = model._obj(content.get("text") if content.get("@type") == "messageText" else content.get("caption"),
                               "formattedText")
            text = value.get("text") if isinstance(value.get("text"), str) else ""
            execute = getattr(self.td, "execute", None)
            written = None
            if text and execute is not None:
                try:
                    written = execute({"@type": "getMarkdownText", "text": value})
                except (OSError, ValueError):
                    written = None
            if isinstance(written, dict) and isinstance(written.get("text"), str):
                text = written["text"]
            return {"text": text[:MARKDOWN_TEXT_MAX]}
        self.td_send({"@type": "getMessage", "chat_id": arg_int(args, "chatId"), "message_id": arg_int(args, "messageId", 1)},
                     client, rid, markdown)

    def cmd_message_delete(self, client, rid, args):
        revoke = args.get("revoke", True)
        if not isinstance(revoke, bool):
            raise BadRequest("revoke must be true or false")
        self.td_send({"@type": "deleteMessages", "chat_id": arg_int(args, "chatId"),
                      "message_ids": arg_ids(args, "messageIds"), "revoke": revoke}, client, rid)

    def cmd_file_download(self, client, rid, args):
        query = {"@type": "downloadFile", "file_id": arg_int(args, "fileId", 1, FILE_ID_MAX),
                 "priority": arg_int(args, "priority", 1, 32, 16), "offset": 0, "limit": 0, "synchronous": False}
        self.td_send(query, client, rid, lambda f: model.file_view(f, self.state.files_root) or {})

    def cmd_sticker_lottie(self, client, rid, args):
        def convert(f):
            view = model.file_view(f, self.state.files_root)
            return {"path": lottie_json(view["path"]) if view and view["path"] else ""}
        self.td_send({"@type": "getFile", "file_id": arg_int(args, "fileId", 1, FILE_ID_MAX)}, client, rid, convert)

    def drain_wake(self):
        try:
            while os.read(self.wake_r, 4096):
                pass
        except (BlockingIOError, OSError):
            pass


