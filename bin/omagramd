                      "limit": arg_int(args, "limit", 1, 100, 50)},
                     client, rid, lambda event: {"contacts": self.user_views(event)})

    def new_title(self, args):
        title = arg_str(args, "title", NEW_TITLE_MAX).strip()
        if not title:
            raise BadRequest("a new chat needs a name")
        return title

    def cmd_group_create(self, client, rid, args):
        title = self.new_title(args)
        users = args.get("userIds", [])
        if (not isinstance(users, list) or len(users) > NEW_MEMBERS_MAX
                or any(isinstance(u, bool) or not isinstance(u, int) or not 0 < u <= INT64_MAX for u in users)):
            raise BadRequest(f"userIds is a list of at most {NEW_MEMBERS_MAX} people")

        def created(event):
            failed = model._obj(event.get("failed_to_add_members")).get("failed_to_add_members")
            return {"chatId": model._int(event.get("chat_id")), "notAdded": len(model._list(failed, NEW_MEMBERS_MAX))}
        self.td_send({"@type": "createNewBasicGroupChat", "user_ids": users, "title": title, "message_auto_delete_time": 0},
                     client, rid, created)

    def cmd_channel_create(self, client, rid, args):
        title = self.new_title(args)
        description = args.get("description", "")
        if not isinstance(description, str) or len(description) > NEW_DESCRIPTION_MAX:
            raise BadRequest(f"a description is text of at most {NEW_DESCRIPTION_MAX} characters")
        self.td_send({"@type": "createNewSupergroupChat", "title": title, "is_forum": False,
                      "is_channel": args.get("channel", True) is True, "description": description, "location": None,
                      "message_auto_delete_time": 0, "for_import": False},
                     client, rid, lambda chat: {"chatId": model._int(chat.get("id"))})

    # ---------------------------------------------------------------- your profile

    def profile_view(self, user, full):
        """You, as the settings show you: your names, username, bio, phone number and photo."""
        photo = model._obj(user.get("profile_photo"), "profilePhoto")
        small = model.file_view(photo.get("small"), self.state.files_root) if photo else None
        photo_id = model._int(photo.get("id")) if photo else 0
        return {"userId": model._int(user.get("id")),
                "firstName": model._str(user.get("first_name"), PROFILE_NAME_MAX),
                "lastName": model._str(user.get("last_name"), PROFILE_NAME_MAX),
                "username": model._str(model._obj(user.get("usernames")).get("editable_username"), USERNAME_MAX),
                "phone": model._str(user.get("phone_number"), 32),
                "bio": model.formatted(model._obj(full).get("bio"))[0][:BIO_MAX],
                "photo": {"file": small, "mini": model.minithumbnail(photo.get("minithumbnail"))} if small else None,
                "photoId": str(photo_id) if photo_id else ""}

    def about_me(self, client, rid, then):
        """Asks TDLib who you are and hands your user to `then`; a refusal goes to the client."""
        def failed(error):
            self.respond_error(client, rid, model._str(error.get("message"), 200) or "Telegram did not say who you are")
        self.td_send({"@type": "getMe"}, transform=then, failed=failed)

    def cmd_profile_get(self, client, rid, args):
        def got(user):
            uid = model._int(user.get("id"))
            if uid <= 0:
                self.respond_error(client, rid, "Telegram did not say who you are")
                return
            self.td_send({"@type": "getUserFullInfo", "user_id": uid}, client, rid, lambda full: self.profile_view(user, full))
        self.about_me(client, rid, got)

    def cmd_profile_set_name(self, client, rid, args):
        first = arg_str(args, "firstName", PROFILE_NAME_MAX).strip()
        last = arg_str(args, "lastName", PROFILE_NAME_MAX, 0).strip()
        if not first:
            raise BadRequest("a first name is needed")
        if any(ord(c) < 32 for c in first + last):
            raise BadRequest("a name is one line")
        self.td_send({"@type": "setName", "first_name": first, "last_name": last}, client, rid)

    def cmd_profile_set_bio(self, client, rid, args):
        bio = arg_str(args, "bio", BIO_MAX, 0)
        if any(ord(c) < 32 for c in bio):
            raise BadRequest("a bio is one line")
        self.td_send({"@type": "setBio", "bio": bio.strip()}, client, rid)

    def cmd_profile_set_username(self, client, rid, args):
        """An empty username removes it."""
        username = arg_str(args, "username", USERNAME_MAX + 1, 0).strip()
        if username.startswith("@"):
            username = username[1:]
        if username and not USERNAME.fullmatch(username):
            raise BadRequest("a username is 5-32 letters, digits and underscores, starting with a letter")
        self.td_send({"@type": "setUsername", "username": username}, client, rid)

    def cmd_profile_set_photo(self, client, rid, args):
        """A new profile photo from a picture you chose, cut to a centred square JPEG first. The copy
        is deleted once Telegram has the photo, or has refused it."""
        source, _ = local_upload(args.get("path"))
        target = media.new_path("profile", ".jpg")

        def done(_answer):
            media.remove(target)
            self.respond(client, rid, {})

        def refused(error):
            media.remove(target)
            self.respond_error(client, rid, model._str(error.get("message"), 200) or "Telegram did not take the photo")

        def converted(_result, error):
            if error is not None:
                media.remove(target)
                self.respond_error(client, rid, "that picture could not be read")
                return
            self.td_send({"@type": "setProfilePhoto", "is_public": False,
                          "photo": {"@type": "inputChatPhotoStatic", "photo": {"@type": "inputFileLocal", "path": str(target)}}},
                         transform=done, failed=refused)
        self.background(lambda: media.prepare_profile_photo(source, target), converted)

    def cmd_profile_delete_photo(self, client, rid, args):
        def got(user):
            photo_id = model._int(model._obj(user.get("profile_photo"), "profilePhoto").get("id"))
            if not photo_id:
                self.respond_error(client, rid, "you have no profile photo")
                return
            self.td_send({"@type": "deleteProfilePhoto", "profile_photo_id": photo_id}, client, rid)
        self.about_me(client, rid, got)

    # ---------------------------------------------------------------- privacy and security

    def cmd_privacy_get(self, client, rid, args):
        """Every privacy setting Settings shows, asked for at once; null for one Telegram did not answer."""
        views = {}

        def settle(setting_id, view):
            views[setting_id] = view
            if len(views) == len(model.PRIVACY_SETTINGS):
                self.respond(client, rid, {"settings": {k: views[k] for k in model.PRIVACY_SETTINGS}})

        for setting_id, kind in model.PRIVACY_SETTINGS.items():
            self.td_send({"@type": "getUserPrivacySettingRules", "setting": {"@type": kind}},
                         transform=lambda event, s=setting_id: settle(s, model.privacy_view(event)),
                         failed=lambda _error, s=setting_id: settle(s, None))

    def cmd_privacy_set(self, client, rid, args):
        """Who in general may see or do something; the exceptions you made stay where they still count."""
        setting_id, base = args.get("setting"), args.get("base")
        kind = model.PRIVACY_SETTINGS.get(setting_id) if isinstance(setting_id, str) else None
        if kind is None:
            raise BadRequest("that is not a privacy setting Omagram shows")
        choices = ("everybody", "contacts") if setting_id == "findByPhone" else ("everybody", "contacts", "nobody")
        if base not in choices:
            raise BadRequest(f"{setting_id} is one of {', '.join(choices)}")
        setting = {"@type": kind}

        def got(event):
            rules = model.privacy_rules(event, base)
            self.td_send({"@type": "setUserPrivacySettingRules", "setting": setting, "rules": rules}, client, rid,
                         lambda _ok: dict(model.privacy_view(rules), setting=setting_id))

        def failed(error):
            self.respond_error(client, rid, model._str(error.get("message"), 200) or "Telegram did not say the setting's rules")
        self.td_send({"@type": "getUserPrivacySettingRules", "setting": setting}, transform=got, failed=failed)

    def cmd_blocked_list(self, client, rid, args):
        offset = arg_int(args, "offset", 0, 100000, 0)

        def senders(event):
            out = []
            for raw in model._list(event.get("senders"), 100):
                sender, name = self.state.sender(raw)
                if sender["id"] and sender["type"] in ("user", "chat"):
                    out.append(dict(sender, name=name or ("Deleted account" if sender["type"] == "user" else "Chat")))
            return {"total": max(0, model._int(event.get("total_count"))), "offset": offset, "senders": out}
        self.td_send({"@type": "getBlockedMessageSenders", "block_list": {"@type": "blockListMain"}, "offset": offset,
                      "limit": 100}, client, rid, senders)

    def cmd_blocked_unblock(self, client, rid, args):
        kind, sender_id = args.get("type"), arg_int(args, "id")
        if kind == "user" and sender_id > 0:
            sender = {"@type": "messageSenderUser", "user_id": sender_id}
        elif kind == "chat" and sender_id < 0:
            sender = {"@type": "messageSenderChat", "chat_id": sender_id}
        else:
            raise BadRequest("a blocked sender is a user or a chat")
        self.td_send({"@type": "setMessageSenderBlockList", "sender_id": sender, "block_list": None}, client, rid)

    def cmd_password_get(self, client, rid, args):
        self.td_send({"@type": "getPasswordState"}, client, rid, model.password_view)

    def cmd_password_set(self, client, rid, args):
        """Turns two-step verification on (no old password), changes the password, or turns it off (no new
        one). The passwords go to TDLib and nowhere else: never into an error message or a log."""
        old = arg_str(args, "oldPassword", PASSWORD_MAX, 0)
        new = arg_str(args, "newPassword", PASSWORD_MAX, 0)
        hint = arg_str(args, "hint", HINT_MAX, 0).strip() if new else ""
        email = arg_str(args, "email", EMAIL_MAX, 0).strip() if args.get("email") is not None else ""
        if hint and hint == new:
            raise BadRequest("the hint cannot be the password itself")
        if email and not EMAIL.fullmatch(email):
            raise BadRequest("that is not an email address")
        self.td_send({"@type": "setPassword", "old_password": old, "new_password": new, "new_hint": hint,
                      "set_recovery_email_address": bool(email), "new_recovery_email_address": email},
                     client, rid, model.password_view)

    def cmd_password_check_email_code(self, client, rid, args):
        code = arg_str(args, "code", 32).strip()
        if not code:
            raise BadRequest("the code from the email is needed")
        self.td_send({"@type": "checkRecoveryEmailAddressCode", "code": code}, client, rid, model.password_view)

    def cmd_password_resend_email_code(self, client, rid, args):
        self.td_send({"@type": "resendRecoveryEmailAddressCode"}, client, rid, model.password_view)

    def cmd_account_ttl(self, client, rid, args):
        self.td_send({"@type": "getAccountTtl"}, client, rid, lambda event: {"days": max(0, model._int(event.get("days")))})

    def cmd_account_set_ttl(self, client, rid, args):
        days = arg_int(args, "days", *ACCOUNT_TTL_DAYS)
        self.td_send({"@type": "setAccountTtl", "ttl": {"@type": "accountTtl", "days": days}}, client, rid,
                     lambda _ok: {"days": days})

    # ---------------------------------------------------------------- notifications by type of chat

    def cmd_notifications_get(self, client, rid, args):
        """Notifications for private chats, groups and channels that have no setting of their own; null
        for a type Telegram did not answer for."""
        views = {}

        def settle(scope, view):
            views[scope] = view
            if len(views) == len(model.NOTIFICATION_SCOPES):
                self.respond(client, rid, {"scopes": {k: views[k] for k in model.NOTIFICATION_SCOPES}})

        for scope, kind in model.NOTIFICATION_SCOPES.items():
            self.td_send({"@type": "getScopeNotificationSettings", "scope": {"@type": kind}},
                         transform=lambda event, s=scope: settle(s, model.scope_view(event)),
                         failed=lambda _error, s=scope: settle(s, None))

    def cmd_notifications_set(self, client, rid, args):
        """Mutes or unmutes a type of chat, or shows or hides message text in its notifications; the rest of
        Telegram's settings for it (sounds, stories) is written back as it was."""
        scope = args.get("scope")
        kind = model.NOTIFICATION_SCOPES.get(scope) if isinstance(scope, str) else None
        if kind is None:
            raise BadRequest("scope is private, groups or channels")
        muted, preview = args.get("muted"), args.get("preview")
        if (muted is None and preview is None) or any(v is not None and not isinstance(v, bool) for v in (muted, preview)):
            raise BadRequest("muted or preview, true or false")

        def got(event):
            settings = model.scope_settings(event, muted, preview)
            self.td_send({"@type": "setScopeNotificationSettings", "scope": {"@type": kind}, "notification_settings": settings},
                         client, rid, lambda _ok: dict(model.scope_view(settings), scope=scope))

        def failed(error):
            self.respond_error(client, rid, model._str(error.get("message"), 200) or "Telegram did not say the settings")
        self.td_send({"@type": "getScopeNotificationSettings", "scope": {"@type": kind}}, transform=got, failed=failed)

    # ---------------------------------------------------------------- chat folders

    def cmd_folders_get(self, client, rid, args):
        """Every chat folder with what it holds, in Telegram's order; one Telegram does not answer for is left out."""
        ids = [f["id"] for f in self.state.folders]
        views = {}

        def settle(fid, view):
            views[fid] = view
            if len(views) == len(ids):
                self.respond(client, rid, {"folders": [views[i] for i in ids if views[i]], "mainPosition": self.state.main_position})

        if not ids:
            self.respond(client, rid, {"folders": [], "mainPosition": self.state.main_position})
        for fid in ids:
            self.td_send({"@type": "getChatFolder", "chat_folder_id": fid},
                         transform=lambda event, f=fid: settle(f, model.folder_view(event, f)),
                         failed=lambda _error, f=fid: settle(f, None))

    def cmd_folder_save(self, client, rid, args):
        """Creates a folder, or changes the one with `id`."""
        folder = folder_object(args)
        if args.get("id") is None:
            self.td_send({"@type": "createChatFolder", "folder": folder}, client, rid,
                         lambda info: {"id": model._int(model._obj(info, "chatFolderInfo").get("id"))})
            return
        fid = arg_int(args, "id", 1, INT32_MAX)
        self.td_send({"@type": "editChatFolder", "chat_folder_id": fid, "folder": folder}, client, rid, lambda _info: {"id": fid})

    def cmd_folder_delete(self, client, rid, args):
        """Deletes a folder; the chats in it stay where they are."""
        self.td_send({"@type": "deleteChatFolder", "chat_folder_id": arg_int(args, "id", 1, INT32_MAX), "leave_chat_ids": []},
                     client, rid)

    def cmd_folders_reorder(self, client, rid, args):
        ids, known = args.get("ids"), [f["id"] for f in self.state.folders]
        if (not isinstance(ids, list) or any(isinstance(i, bool) or not isinstance(i, int) for i in ids)
                or sorted(ids) != sorted(known)):
            raise BadRequest("ids are every folder's id, in the new order")
        self.td_send({"@type": "reorderChatFolders", "chat_folder_ids": ids, "main_chat_list_position": self.state.main_position},
                     client, rid)

    # ---------------------------------------------------------------- devices and storage

    def cmd_sessions_list(self, client, rid, args):
        def sessions(event):
            views = [v for v in (model.session_view(s) for s in model._list(event.get("sessions"), 100)) if v]
            views.sort(key=lambda v: (not v["current"], -v["lastActive"]))
            return {"sessions": views, "inactiveDays": max(0, model._int(event.get("inactive_session_ttl_days")))}
        self.td_send({"@type": "getActiveSessions"}, client, rid, sessions)

    def cmd_session_terminate(self, client, rid, args):
        sid = args.get("id")
        if not isinstance(sid, str) or not SESSION_ID.fullmatch(sid) or not -2 ** 63 <= int(sid) < 2 ** 63:
            raise BadRequest("id is a session id, as text")
        self.td_send({"@type": "terminateSession", "session_id": int(sid)}, client, rid)

    def cmd_sessions_terminate_others(self, client, rid, args):
        self.td_send({"@type": "terminateAllOtherSessions"}, client, rid)

    def cmd_storage_stats(self, client, rid, args):
        def stats(event):
            return {"filesSize": max(0, model._int(event.get("files_size"))), "fileCount": max(0, model._int(event.get("file_count"))),
                    "databaseSize": max(0, model._int(event.get("database_size"))),
                    "logSize": max(0, model._int(event.get("log_size"))),
                    "stickerCacheSize": sum(st.st_size for _, st in lottie_cache_entries())}
        self.td_send({"@type": "getStorageStatisticsFast"}, client, rid, stats)

    def cmd_storage_clear(self, client, rid, args):
        """Deletes every downloaded file TDLib may delete (they download again when needed) and the
        unpacked stickers. The voice and video messages you sent stay."""
        def cleared(event):
            clear_lottie_cache()
            return {"remaining": max(0, model._int(event.get("size")))}
        self.td_send({"@type": "optimizeStorage", "size": 0, "ttl": 0, "count": 0, "immunity_delay": 0, "file_types": [],
                      "chat_ids": [], "exclude_chat_ids": [], "return_deleted_file_statistics": False, "chat_limit": 0},
                     client, rid, cleared)

    # ---------------------------------------------------------------- forum topics

    def cmd_topics_list(self, client, rid, args):
        chat_id = arg_int(args, "chatId")
        query = args.get("query", "")
        if not isinstance(query, str) or len(query) > QUERY_MAX:
            raise BadRequest("query is text")

        def topics(event):
            views = [v for v in (self.state.topic_view(t) for t in model._list(event.get("topics"), 100)) if v]
            return {"chatId": chat_id, "topics": views, "total": max(0, model._int(event.get("total_count"))),
                    "next": {"offsetDate": model._int(event.get("next_offset_date")),
                             "offsetMessageId": model._int(event.get("next_offset_message_id")),
                             "offsetTopicId": model._int(event.get("next_offset_forum_topic_id"))}}
        self.td_send({"@type": "getForumTopics", "chat_id": chat_id, "query": query,
                      "offset_date": arg_int(args, "offsetDate", 0, INT32_MAX, 0),
                      "offset_message_id": arg_int(args, "offsetMessageId", 0, None, 0),
                      "offset_forum_topic_id": arg_int(args, "offsetTopicId", 0, INT32_MAX, 0),
                      "limit": arg_int(args, "limit", 1, 100, 50)}, client, rid, topics)

    def cmd_topic_history(self, client, rid, args):
        chat_id, topic = arg_int(args, "chatId"), arg_int(args, "topicId", 1, INT32_MAX)

        def messages(event):
            found = [self.state.message(m) for m in model._list(event.get("messages"), 100)]
            return {"chatId": chat_id, "topicId": topic, "messages": [m for m in found if m]}
        self.td_send({"@type": "getForumTopicHistory", "chat_id": chat_id, "forum_topic_id": topic,
                      "from_message_id": arg_int(args, "fromMessageId", 0, None, 0),
                      "offset": arg_int(args, "offset", -99, 0, 0), "limit": arg_int(args, "limit", 1, 100, 50)},
                     client, rid, messages)

    # ---------------------------------------------------------------- comments and reply threads

    def cmd_thread_open(self, client, rid, args):
        """The comments under a channel post, or the replies to a message in a group: the chat they
        live in (a channel's comments are in its discussion group), the thread there, the messages it
        starts from, and your draft in it."""
        chat_id, message_id = arg_int(args, "chatId"), arg_int(args, "messageId", 1)

        def opened(event):
            thread_chat, thread = model._int(event.get("chat_id")), model._int(event.get("message_thread_id"))
            if not thread_chat or thread <= 0:
                raise BadRequest("that message has no comments or replies")
            found = [self.state.message(m) for m in model._list(event.get("messages"), 10)]
            return {"chatId": thread_chat, "threadId": thread, "fromChatId": chat_id, "fromMessageId": message_id,
                    "messages": [m for m in found if m], "replies": model.replies_view(event.get("reply_info")),
                    "unread": max(0, model._int(event.get("unread_message_count"))),
                    "draft": model.draft_text(event.get("draft_message")), "chat": self.state.chat_view(thread_chat)}
        self.td_send({"@type": "getMessageThread", "chat_id": chat_id, "message_id": message_id}, client, rid, opened)

    def cmd_thread_history(self, client, rid, args):
        chat_id, thread = arg_int(args, "chatId"), arg_int(args, "threadId", 1)

        def messages(event):
            found = [self.state.message(m) for m in model._list(event.get("messages"), 100)]
            return {"chatId": chat_id, "threadId": thread, "messages": [m for m in found if m]}
        self.td_send({"@type": "getMessageThreadHistory", "chat_id": chat_id, "message_id": thread,
                      "from_message_id": arg_int(args, "fromMessageId", 0, None, 0),
                      "offset": arg_int(args, "offset", -99, 0, 0), "limit": arg_int(args, "limit", 1, 100, 50)},
                     client, rid, messages)

    # ---------------------------------------------------------------- scheduled messages, translation

    def cmd_chat_scheduled(self, client, rid, args):
        chat_id = arg_int(args, "chatId")

        def scheduled(event):
            found = [self.state.message(m) for m in model._list(event.get("messages"), 100)]
            return {"chatId": chat_id, "messages": [m for m in found if m]}
        self.td_send({"@type": "getChatScheduledMessages", "chat_id": chat_id}, client, rid, scheduled)

    def cmd_message_reschedule(self, client, rid, args):
        """Another time for a scheduled message: a date, -1 once the other person is online, 0 now."""
        options = self.send_options({"sendAt": args.get("sendAt", 0)})
        self.td_send({"@type": "editMessageSchedulingState", "chat_id": arg_int(args, "chatId"),
                      "message_id": arg_int(args, "messageId", 1),
                      "scheduling_state": options["scheduling_state"] if options else None}, client, rid)

    def cmd_message_translate(self, client, rid, args):
        to = args.get("to") or td.language_code().split("-")[0]
        if not isinstance(to, str) or not TRANSLATE_TO.fullmatch(to):
            raise BadRequest("to is a language code, like en or pt-BR")
        self.td_send({"@type": "translateMessageText", "chat_id": arg_int(args, "chatId"),
                      "message_id": arg_int(args, "messageId", 1), "to_language_code": to, "tone": ""},
                     client, rid, lambda event: dict(model.formatted_view(event), to=to))

    # ---------------------------------------------------------------- GIFs and custom emoji

    def gif_views(self, animations):
        views = (model.media_for("gif", {"animation": raw}, self.state.files_root) for raw in animations)
        return [v for v in views if v is not None]

    def cmd_gifs_saved(self, client, rid, args):
        self.td_send({"@type": "getSavedAnimations"}, client, rid,
                     lambda event: {"gifs": self.gif_views(model._list(event.get("animations"), STICKERS_MAX))})

    def cmd_gifs_search(self, client, rid, args):
        """GIFs found the way Telegram's own apps find them: through the @gif inline bot."""
        chat_id = arg_int(args, "chatId")
        query = arg_str(args, "query", QUERY_MAX, 0)
        offset = args.get("offset", "")
        if not isinstance(offset, str) or len(offset) > OFFSET_MAX:
            raise BadRequest("offset is the text a previous search returned")

        def results(event):
            found = []
            for raw in model._list(event.get("results"), 100):
                r = model._obj(raw, "inlineQueryResultAnimation")
                result_id = model._str(r.get("id"), 64)
                view = model.media_for("gif", {"animation": r.get("animation")}, self.state.files_root) if r else None
                if result_id and view is not None:
                    found.append({"id": result_id, "gif": view})
            return {"queryId": str(model._int(event.get("inline_query_id"))),
                    "nextOffset": model._str(event.get("next_offset"), OFFSET_MAX), "results": found}

        def search(bot_id):
            self.td_send({"@type": "getInlineQueryResults", "bot_user_id": bot_id, "chat_id": chat_id, "user_location": None,
                          "query": query, "offset": offset}, client, rid, results)

        def unavailable(_event=None):
            self.respond_error(client, rid, "GIF search is not available")

        def found_bot(chat):
            bot_id = model._int(model._obj(chat.get("type")).get("user_id"))
            if not bot_id:
                unavailable()
                return
            self.gif_bot_id = bot_id
            search(bot_id)

        if self.gif_bot_id:
            search(self.gif_bot_id)
        else:
            self.td_send({"@type": "searchPublicChat", "username": GIF_BOT}, transform=found_bot, failed=unavailable)

    def cmd_message_send_gif(self, client, rid, args):
        """A GIF from a search (queryId and resultId) or one of yours (fileId)."""
        chat_id = arg_int(args, "chatId")
        if args.get("queryId") is not None:
            query_id, result_id = args.get("queryId"), args.get("resultId")
            if (not isinstance(query_id, str) or not INT64_ID.fullmatch(query_id) or not -2 ** 63 <= int(query_id) < 2 ** 63
                    or not isinstance(result_id, str) or not 0 < len(result_id) <= 64):
                raise BadRequest("queryId and resultId come from gifs.search")
            self.td_send({"@type": "sendInlineQueryResultMessage", "chat_id": chat_id, "topic_id": self.topic_of(args),
                          "reply_to": self.reply_to(args), "options": self.send_options(args), "query_id": int(query_id),
                          "result_id": result_id, "hide_via_bot": True}, client, rid, self.state.message)
            return
        animation = {"@type": "inputAnimation", "animation": {"@type": "inputFileId", "id": arg_int(args, "fileId", 1, FILE_ID_MAX)},
                     "thumbnail": None, "added_sticker_file_ids": [], "duration": arg_int(args, "duration", 0, 86400, 0),
                     "width": arg_int(args, "width", 0, 10000, 0), "height": arg_int(args, "height", 0, 10000, 0)}
        self.send_content(client, rid, chat_id, {"@type": "inputMessageAnimation", "animation": animation, "caption": None,
                                                 "show_caption_above_media": False, "has_spoiler": False}, args)

    def cmd_custom_emoji(self, client, rid, args):
        """The stickers custom emoji are drawn with, by their ids (as text: they are int64)."""
        ids = args.get("ids")
        if (not isinstance(ids, list) or not 1 <= len(ids) <= CUSTOM_EMOJI_MAX
                or any(not isinstance(i, str) or not INT64_ID.fullmatch(i) or not -2 ** 63 <= int(i) < 2 ** 63 for i in ids)):
            raise BadRequest("ids is a list of custom emoji ids, as text")

        def stickers(event):
            found = []
            for raw in model._list(event.get("stickers"), CUSTOM_EMOJI_MAX):
                s = model._obj(raw, "sticker")
                full = model._obj(s.get("full_type"), "stickerFullTypeCustomEmoji")
                view = model.media_for("sticker", {"sticker": s}, self.state.files_root) if full else None
                if view is not None:
                    found.append(dict(view, id=str(model._int(full.get("custom_emoji_id")))))
            return {"emoji": found}
        self.td_send({"@type": "getCustomEmojiStickers", "custom_emoji_ids": [int(i) for i in ids]}, client, rid, stickers)

    # ---------------------------------------------------------------- secret chats and calls

    def cmd_secret_create(self, client, rid, args):
        self.td_send({"@type": "createNewSecretChat", "user_id": arg_int(args, "userId", 1)}, client, rid,
                     lambda chat: {"chatId": model._int(chat.get("id"))})

    def cmd_secret_close(self, client, rid, args):
        chat = self.state.chats.get(arg_int(args, "chatId"))
        if chat is None or not chat["secretChatId"]:
            raise BadRequest("that is not a secret chat")
        self.td_send({"@type": "closeSecretChat", "secret_chat_id": chat["secretChatId"]}, client, rid)

    def cmd_call_decline(self, client, rid, args):
        call_id = arg_int(args, "callId", 1, INT32_MAX)
        self.td_send({"@type": "discardCall", "call_id": call_id, "is_disconnected": False, "invite_link": "", "duration": 0,
                      "is_video": self.state.calls.get(call_id, {}).get("video", False), "connection_id": 0}, client, rid)

    # ---------------------------------------------------------------- stories

    def story_args(self, args):
        return arg_int(args, "chatId"), arg_int(args, "storyId", 1, INT32_MAX)

    def cmd_story_get(self, client, rid, args):
