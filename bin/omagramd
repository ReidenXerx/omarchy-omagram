        if not isinstance(remove, bool) or not isinstance(revoke, bool):
            raise BadRequest("removeFromList and revoke are true or false")
        self.td_send({"@type": "deleteChatHistory", "chat_id": arg_int(args, "chatId"), "remove_from_chat_list": remove,
                      "revoke": revoke}, client, rid)

    def cmd_chat_mark_unread(self, client, rid, args):
